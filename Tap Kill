function Core.updateRootLocomotion(state,dt,standH,opts)
local now=os.clock()
local _,hum,hrp=Core.getLocalRoot()
local cam=Workspace.CurrentCamera
opts=opts or{}
local actT=0
if state.activeMove then
local elapsed=now - state.moveStart
if elapsed >=state.moveDuration then
state.activeMove=nil
else
actT=Core.clamp(elapsed / math.max(state.moveDuration,0.01),0,1)
end
end
local desiredPos=state.rootPos
local desiredYaw=state.rootYaw
local mode=state.mode
local hoverFly=(state.flightBoost or state.hoverMode or opts.forceHover)and true or false
local moveVec=Core.V3Z
local wantSprint=state.sprintMode or state.flightBoost
if not state.anchorStance then
if(mode=="Follow"or mode=="Guard"or mode=="Escort")and hrp then
local backD=opts.followBack or -5.2
local sideD=opts.followSide or 7.2
local off=(hrp.CFrame.RightVector * sideD)+(hrp.CFrame.LookVector *(-backD))
local tx,tz=hrp.Position.X + off.X,hrp.Position.Z + off.Z
local gy=Core.rayGroundY(Vector3.new(tx,hrp.Position.Y,tz),state.groundY,state)
state.groundY=gy
local hoverAlt=hoverFly and(4.2 + 0.55 * math.sin(now * 2.2))or(opts.extraY or 0)
desiredPos=Vector3.new(tx,gy + standH + hoverAlt,tz)
desiredYaw=math.atan2(-hrp.CFrame.LookVector.X,-hrp.CFrame.LookVector.Z)
elseif mode=="Pilot"then
local mv,upAxis,sprinting=Core.getPilotInput(state,cam,hrp and hrp.CFrame)
moveVec=mv
wantSprint=sprinting
if moveVec.Magnitude > 1e-4 then
desiredYaw=math.atan2(-moveVec.X,-moveVec.Z)
end
local spd=wantSprint and(opts.sprintSpeed or 48)or(opts.walkSpeed or 28)
local nextXZ=state.rootPos + moveVec *(spd * dt)
local gy=Core.rayGroundY(nextXZ,state.groundY,state)
state.groundY=gy
if upAxis > 0 then hoverFly=true end
local targetY=gy + standH +(opts.extraY or 0)
if hoverFly or math.abs(upAxis)> 0.05 then
targetY=math.max(gy + standH,state.rootPos.Y + upAxis *(opts.vertSpeed or 22)* dt)
end
desiredPos=Vector3.new(nextXZ.X,targetY,nextXZ.Z)
if hrp and not state.rideActive then
local horiz=Vector3.new(desiredPos.X - hrp.Position.X,0,desiredPos.Z - hrp.Position.Z)
if horiz.Magnitude > 76 then
local cl=hrp.Position + horiz.Unit * 76
desiredPos=Vector3.new(cl.X,desiredPos.Y,cl.Z)
end
if state.pilotCloak then
state.wasCloaked=true
pcall(function()
hrp.Anchored=true
hrp.CFrame=CFrame.new(desiredPos.X,state.groundY - 12,desiredPos.Z)* CFrame.Angles(0,desiredYaw,0)
end)
else
pcall(function()hrp.Anchored=true end)
end
end
local camPart=opts.camPart or(state.slots[1]and state.slots[1].primary)
if cam and camPart and camPart.Parent then
state.camWasModded=true
cam.CameraSubject=camPart
end
elseif(mode=="Orbit"or mode=="Surround")and hrp then
local rad=opts.orbitRadius or 13.5
local ang=now *(opts.orbitSpeed or 0.9)
local xz=Vector3.new(hrp.Position.X + math.cos(ang)* rad,hrp.Position.Y,hrp.Position.Z + math.sin(ang)* rad)
local gy=Core.rayGroundY(xz,state.groundY,state)
state.groundY=gy
local tang=Vector3.new(-math.sin(ang),0,math.cos(ang))
desiredPos=Vector3.new(xz.X,gy + standH +(hoverFly and 4.5 or 0),xz.Z)
desiredYaw=math.atan2(-tang.X,-tang.Z)
elseif(mode=="Hunt"or mode=="Stalk")then
local _,tHrp=Core.resolveHuntTarget(state,state.rootPos)
if tHrp then
local flank=-tHrp.CFrame.LookVector *(opts.huntBack or 11.5)+ tHrp.CFrame.RightVector * 4.2
local tx,tz=tHrp.Position.X + flank.X,tHrp.Position.Z + flank.Z
local gy=Core.rayGroundY(Vector3.new(tx,tHrp.Position.Y,tz),state.groundY,state)
state.groundY=gy
