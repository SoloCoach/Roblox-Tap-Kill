local ch=p.Character
local tr=ch and ch:FindFirstChild(_K[55])
local th=ch and ch:FindFirstChildOfClass(_K[104])
if tr and th and th.Health > 0 and readRootVel(tr).Magnitude <=900 then
local d=(tr.Position - hitCenter).Magnitude
