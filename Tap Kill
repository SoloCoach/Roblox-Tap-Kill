0
)
poses.ManeCloudL=aimConeTip(
maneFrameCF * Vector3.new(-0.35,1.55,1.45),
maneFrameCF * Vector3.new(-0.38,3.55,1.65),
2.0,
maneFrameCF.UpVector
)
