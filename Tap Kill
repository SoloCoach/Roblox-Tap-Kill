local function aimBoneCenter(pStart,pEnd,poleZ)
local span=pEnd - pStart
local upY=(span.Magnitude > 1e-4)and span.Unit or Vector3.yAxis
local rightX=upY:Cross(poleZ)
if rightX.Magnitude < 1e-4 then
local alt=(math.abs(upY.Y)< 0.9)and Vector3.yAxis or Vector3.xAxis
rightX=upY:Cross(alt)
end
rightX=rightX.Unit
local backZ=rightX:Cross(upY).Unit
return CFrame.fromMatrix((pStart + pEnd)* 0.5,rightX,upY,backZ)
end
local function evalSignals(state,actT,now,dt)
local rBlast,rTails,rAssault,rDisrupt,rRoar=0,0,0,0,0
