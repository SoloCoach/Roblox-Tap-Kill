local DomEngine={}
function DomEngine.StripTags(str)
local s=tostring(str or"")
s=string.gsub(s,"<br%s*/?>","\n")
s=string.gsub(s,"<[^>]+>"," ")
s=string.gsub(s,"&nbsp;"," ")
s=string.gsub(s,"&amp;","&")
s=string.gsub(s,"&quot;",'"')
s=string.gsub(s,"&#39;","'")
s=string.gsub(s,"&lt;","<")
s=string.gsub(s,"&gt;",">")
s=string.gsub(s,"%s+"," ")
return string.match(s,"^%s*(.-)%s*$")or""
end
function DomEngine.SearchGoogleWeb(query)
local results={}
local encoded=HttpService:UrlEncode(query)
local ytVideos=YouTubeEngine.SearchVideos(query,2)
for _,v in ipairs(ytVideos)do
table.insert(results,{
IsVideo=true,
