--  Brookhaven Kill Tool v2 — Anti-kick
-- ═══════════════════════════════════════════════════════════
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lp = Players.LocalPlayer

-- ═══ 1. Təmiz FireServer (yenə lazımdır) ═══
local _cleanFireServer
pcall(function()
    local dummy = Instance.new("RemoteEvent")
    _cleanFireServer = clonefunction(dummy.FireServer)
    dummy:Destroy()
end)
if not _cleanFireServer then
    _cleanFireServer = function(remote, ...)
        pcall(function() remote:FireServer(...) end)
    end
end

-- ═══ 2. Yalnız BİR dəfə remote göndər, spam etmə ═══
local _lastKillTime = 0
local _killCooldown = 1.0  -- 1 saniyə cooldown (anti-cheat üçün)

local function killPlayer(target)
    if not target or target == lp then return false end
    if tick() - _lastKillTime < _killCooldown then
        return false  -- cooldown aktivdir, spam yoxdur
    end

    local char = target.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    _lastKillTime = tick()

    -- ═══ YALNIZ 1 remote çağırışı — spam yoxdur ═══
    -- Əvvəlcə ən çox ehtimal olunan remote-u tap
    local remote = nil
    local function findOne()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local n = obj.Name:lower()
                if n:find("kill", 1, true)
                    or n:find("damage", 1, true)
                    or n:find("hurt", 1, true) then
                    remote = obj
                    return
                end
            end
        end
    end
    pcall(findOne)

    if remote then
        -- YALNIZ BİR parametr formatı cəhd et
        pcall(function()
            _cleanFireServer(remote, char)
        end)
    end

    -- Fallback: lokal kill (remote tapılmasa)
    pcall(function() hum.Health = 0 end)
    return true
end

-- ═══ 3. Tool — DÜZGÜN struktur ═══
local tool = Instance.new("Tool")
tool.Name = "Kill Tool"
tool.RequiresHandle = true
tool.CanBeDropped = false
tool.ToolTip = "Oyunçunun üstünə bas"

local handle = Instance.new("Part")
handle.Name = "Handle"
handle.Size = Vector3.new(1, 1, 1)
handle.Transparency = 0.3
handle.Material = Enum.Material.Neon
handle.Color = Color3.fromRGB(255, 0, 0)
handle.CanCollide = false  -- ← BU VACİB: toqquşma problemlərini önləyir
handle.Parent = tool  -- ← Handle tool-un içindədir, düzgündür

-- Touched ilə kill (yalnız bir dəfə)
local _touchedPlayers = {}
handle.Touched:Connect(function(hit)
    local char = hit.Parent
    if not char then return end
    local player = Players:GetPlayerFromCharacter(char)
    if player and player ~= lp and not _touchedPlayers[player] then
        _touchedPlayers[player] = true
        killPlayer(player)
        task.wait(1)
        _touchedPlayers[player] = nil
    end
end)

tool.Parent = lp:WaitForChild("Backpack")

-- ═══ 4. Sol üstdə ad qutusu ═══
local gui = Instance.new("ScreenGui")
gui.Name = "KillMenu"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
local ok = pcall(function() gui.Parent = game:GetService("CoreGui") end)
if not ok then gui.Parent = lp:WaitForChild("PlayerGui") end

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 240, 0, 42)
frame.Position = UDim2.new(0, 12, 0, 12)
frame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
frame.BorderSizePixel = 0

local corner = Instance.new("UICorner", frame)
corner.CornerRadius = UDim.new(0, 10)

local stroke = Instance.new("UIStroke", frame)
stroke.Color = Color3.fromRGB(255, 50, 50)
stroke.Thickness = 1.5

local box = Instance.new("TextBox", frame)
box.Size = UDim2.new(1, -20, 1, -12)
box.Position = UDim2.new(0, 10, 0, 6)
box.BackgroundTransparency = 1
box.Text = ""
box.PlaceholderText = "Oyunçu adı daxil et..."
box.TextColor3 = Color3.fromRGB(255, 255, 255)
box.PlaceholderColor3 = Color3.fromRGB(150, 150, 160)
box.Font = Enum.Font.GothamBold
box.TextSize = 13
box.ClearTextOnFocus = false
box.TextXAlignment = Enum.TextXAlignment.Left

box.FocusLost:Connect(function(enter)
    if not enter then return end
    local name = box.Text
    if name == "" then return end

    local target = Players:FindFirstChild(name)
    if not target then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and p.Name:lower():find(name:lower(), 1, true) then
                target = p
                break
            end
        end
    end

    if target and target ~= lp then
        killPlayer(target)
        box.Text = "✓ " .. target.Name
        box.TextColor3 = Color3.fromRGB(100, 255, 100)
        task.wait(1.5)
        box.Text = ""
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        box.Text = "✗ Tapılmadı"
        box.TextColor3 = Color3.fromRGB(255, 100, 100)
        task.wait(1.5)
        box.Text = ""
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)
