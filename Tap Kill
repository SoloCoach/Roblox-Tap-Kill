anySuccess=true
for _,f in ipairs(data.friends or{})do
local fk=normalizeHandle(f.username or f.name or"")
if #fk > 0 and not seenFriends[fk]then
seenFriends[fk]=true
table.insert(mergedFriends,f)
end
end
for _,req in ipairs(data.pendingIncoming or{})do
local rk=normalizeHandle(req.from or"")
if #rk > 0 and not seenIncoming[rk]then
seenIncoming[rk]=true
table.insert(mergedIncoming,req)
end
end
elseif data then
lastErr=data
end
