local function solveSpiderLimb(
coxaPos: Vector3,
footPos: Vector3,
side: number,
femurLen: number,
tibiaLen: number,
kneeArchBoost: number
):(CFrame,CFrame,CFrame)
local toFoot=footPos - coxaPos
local dist=math.clamp(toFoot.Magnitude,1.8,(femurLen + tibiaLen)* 0.96)
local dirUnit=(toFoot.Magnitude > 0.01)and toFoot.Unit or Vector3.new(0,-1,0)
local cosAlpha=math.clamp(
(femurLen * femurLen + dist * dist - tibiaLen * tibiaLen)/(2 * femurLen * dist),
-0.98,
0.98
)
local alpha=math.acos(cosAlpha)+ kneeArchBoost
local upHint=Vector3.new(-dirUnit.Z * side * 0.25,1.65,dirUnit.X * side * 0.25).Unit
local basis=CFrame.lookAt(coxaPos,coxaPos + dirUnit,upHint)
local femurDir=(basis * CFrame.Angles(alpha,0,0)).LookVector
local patellaPos=coxaPos + femurDir * femurLen
local femurMid=coxaPos:Lerp(patellaPos,0.5)
local femurCF=CFrame.lookAt(femurMid,patellaPos)* CFrame.Angles(0,math.rad(90),0)
local tibiaMid=patellaPos:Lerp(footPos,0.5)
local tibiaCF=CFrame.lookAt(tibiaMid,footPos)* CFrame.Angles(0,math.rad(90),0)
local clawCF=CFrame.lookAt(footPos + Vector3.new(0,0.95,0),footPos)
* CFrame.Angles(math.rad(-20),0,0)
return femurCF,tibiaCF,clawCF
end
