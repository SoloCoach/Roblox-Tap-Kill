end
local function headingDelta(cfA,cfB)
local a=cfA.LookVector
local b=cfB.LookVector
local flatA=Vector3.new(a.X,0,a.Z)
local flatB=Vector3.new(b.X,0,b.Z)
if flatA.Magnitude < 1e-3 or flatB.Magnitude < 1e-3 then return 0 end
local dot=math.clamp(flatA.Unit:Dot(flatB.Unit),-1,1)
return math.deg(math.acos(dot))
end
local function checkPlayerForBang(otherPlr,now)
if otherPlr==lp then return false end
local otherChar=otherPlr.Character
local otherHRP=otherChar and otherChar:FindFirstChild(_K[55])
local otherHum=otherChar and otherChar:FindFirstChildOfClass(_K[104])
local myChar=lp.Character
local myHRP=myChar and myChar:FindFirstChild(_K[55])
if not otherHRP or not myHRP then return false end
local myCF=myHRP.CFrame
local relRoot=myCF:PointToObjectSpace(otherHRP.Position)
local facingDot=myCF.LookVector:Dot(otherHRP.CFrame.LookVector)
local inZone=math.abs(relRoot.X)<=AntiBangState.maxSideOffset
and math.abs(relRoot.Z)<=AntiBangState.maxFrontBack
and relRoot.Y >=-AntiBangState.maxBelow
and relRoot.Y <=AntiBangState.maxAbove
local data=AntiBangState.targetHistory[otherPlr]
if not inZone then
if data and(now - data.lastInZone)> AntiBangState.zoneGraceTime then
AntiBangState.targetHistory[otherPlr]=nil
end
return false
end
if not data then
data={
enteredAt=now,
lastInZone=now,
anchorRel=relRoot,
anchorCF=myCF,
maxDrift=0,
maxTurn=0,
rootX=newOscillator(AntiBangState.rootHysteresis),
rootZ=newOscillator(AntiBangState.rootHysteresis),
torsoX=newOscillator(AntiBangState.torsoHysteresis),
torsoZ=newOscillator(AntiBangState.torsoHysteresis),
}
AntiBangState.targetHistory[otherPlr]=data
end
data.lastInZone=now
local rootRev=math.max(
feedOscillator(data.rootX,relRoot.X,now),
feedOscillator(data.rootZ,relRoot.Z,now)
)
local torsoRev=0
local torso=otherChar:FindFirstChild(_K[94])or otherChar:FindFirstChild(_K[120])
if torso then
local relTorso=myCF:PointToObjectSpace(torso.Position)
torsoRev=math.max(
feedOscillator(data.torsoX,relTorso.X,now),
feedOscillator(data.torsoZ,relTorso.Z,now)
)
end
local drift=(relRoot - data.anchorRel).Magnitude
if drift > data.maxDrift then data.maxDrift=drift end
local turn=headingDelta(data.anchorCF,myCF)
if turn > data.maxTurn then data.maxTurn=turn end
local anchorHorizontal=Vector2.new(data.anchorRel.X,data.anchorRel.Z).Magnitude
local rotationLocked=data.maxTurn >=AntiBangState.lockMinTurnDegrees
and data.maxDrift <=AntiBangState.lockMaxDrift
and anchorHorizontal >=1.0
if data.maxDrift > AntiBangState.lockMaxDrift then
data.anchorRel=relRoot
data.anchorCF=myCF
data.maxDrift=0
data.maxTurn=0
end
local animFlag=hasTrollAnimation(otherHum)
local variant=classifyVariant(relRoot,facingDot)
local seatedOnHead=variant=="headsit"
and otherHum ~=nil
and(otherHum.Sit or otherHum.PlatformStand)
and otherHum.SeatPart==nil
local glueTime=now - data.enteredAt
if glueTime < AntiBangState.minGlueTime then
return false
end
if animFlag then
return true,variant .." (animation)"
end
if torsoRev >=AntiBangState.minReversals then
return true,variant .." (torso loop)"
end
if rootRev >=AntiBangState.minReversals then
return true,variant .." (root loop)"
end
if seatedOnHead then
return true,"headsit (seated on head)"
end
if rotationLocked then
return true,variant .." (locked to you)"
end
return false
end
local function executeAntiBangPunishment(trollPlayer,reason)
