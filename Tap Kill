local rBite,rRoar,rStomp,rWhip=0,0,0,0
if state.activeMove=="Bite"then
if actT < 0.28 then rBite=-(actT / 0.28)* 0.55
elseif actT < 0.58 then rBite=-0.55 +((actT - 0.28)/ 0.30)* 1.55
else rBite=1 -(actT - 0.58)/ 0.42 end
elseif state.activeMove=="Roar"then rRoar=math.sin(actT * math.pi)
elseif state.activeMove=="Stomp"then rStomp=math.sin(actT * math.pi)
elseif state.activeMove=="TailWhip"then rWhip=math.sin(actT * math.pi)end
local a=state.anim
a.bite=expBlend(a.bite or 0,rBite,20,dt)
a.roar=expBlend(a.roar or 0,rRoar,11,dt)
a.stomp=expBlend(a.stomp or 0,rStomp,16,dt)
a.whip=expBlend(a.whip or 0,rWhip,14,dt)
a.crouch=expBlend(a.crouch or 0,state.specialActive and 1 or 0,9,dt)
if state.moveSpeed > 0.5 then
state.stridePhase=state.stridePhase + dt *(3.4 + state.moveSpeed * 0.16)
end
local g=Core.evalBipedGait(state.stridePhase,state.moveSpeed,22,true)
local breath=math.sin(now * 1.7)
local pelDrop=-0.55 * g.impact - 2.6 * a.crouch + 0.35 * a.roar - 0.28 * g.doubleBump + 0.12 * breath
local bodyPitch=-8 - 10 * g.run - 16 * a.crouch + 24 * a.roar - 12 * math.max(0,a.bite)
local pelYaw=-75 * a.whip + 6.5 * g.pelvisYaw
