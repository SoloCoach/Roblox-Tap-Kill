local function normalizeIdentifier(str)
if type(str)~="string"then return""end
local cleaned=string.lower(str)
cleaned=string.gsub(cleaned,"^@","")
cleaned=string.gsub(cleaned,"^%s*(.-)%s*$","%1")
return cleaned
end
local function isSenderMe(senderField)
if not senderField then return false end
local clean=normalizeIdentifier(tostring(senderField))
local myU=normalizeIdentifier(TyShCloud.CurrentUser or phoneConfig.username or"")
local myRoblox=(lp and normalizeIdentifier(lp.Name))or""
local myRobloxDisp=(lp and normalizeIdentifier(lp.DisplayName))or""
local myId=(lp and tostring(lp.UserId))or""
return clean==myU or clean==myRoblox or clean==myRobloxDisp or clean==myId
end
