local function updateVolumeUI()
local pct=math.floor(SState.volume * 100)
local maxCap=SState.isOverloud and 2.5 or 1.0
local barRatio=math.clamp(SState.volume / maxCap,0,1)
if SState.isOverloud then
SState.volText.Text=string.format("OVERLOUD: %d%%",pct)
SState.volText.TextColor3=Color3.fromRGB(255,68,68)
overloudBtn.Text="OVERLOUD ON"
overloudBtn.BackgroundColor3=Color3.fromRGB(220,38,38)
ocStroke.Color=Color3.fromRGB(255,100,100)
volBarFill.BackgroundColor3=Color3.fromRGB(255,68,68)
vcStroke.Color=Color3.fromRGB(180,40,40)
else
SState.volText.Text=string.format("VOLUME: %d%%",pct)
SState.volText.TextColor3=Color3.fromRGB(30,185,85)
overloudBtn.Text="OVERLOUD"
overloudBtn.BackgroundColor3=Color3.fromRGB(30,34,46)
ocStroke.Color=Color3.fromRGB(48,54,72)
volBarFill.BackgroundColor3=Color3.fromRGB(30,185,85)
vcStroke.Color=Color3.fromRGB(32,36,48)
end
volBarFill.Size=UDim2.new(barRatio,0,1,0)
end
updateVolumeUI()
local function applyVolumeChange(newVol)
local maxLimit=SState.isOverloud and 2.5 or 1.0
SState.volume=math.clamp(newVol,0,maxLimit)
if SState.currentSound then
SState.currentSound.Volume=SState.volume
end
phoneConfig.spotifyVolume=SState.volume
phoneConfig.spotifyOverloud=SState.isOverloud
saveConfig()
updateVolumeUI()
end
