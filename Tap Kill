local MAX_HORIZONTAL_SPEED=85
local MAX_UPWARD_SPEED=110
local MAX_DOWNWARD_SPEED=260
local MAX_ANGULAR_SPEED=40
local lastSafeCFrame=nil
local lastSafeVelocity=Vector3.zero
local function isVelocityAnomalous(linVel,angVel)
local horizSpeed=Vector3.new(linVel.X,0,linVel.Z).Magnitude
if horizSpeed > MAX_HORIZONTAL_SPEED then
return true
end
if linVel.Y > MAX_UPWARD_SPEED or linVel.Y < -MAX_DOWNWARD_SPEED then
return true
end
if angVel.Magnitude > MAX_ANGULAR_SPEED then
return true
end
return false
end
