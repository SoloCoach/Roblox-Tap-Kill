function Network.HashString(str)
local h=5381
for i=1,#str do
h=((h * 33)+ string.byte(str,i))% 4294967296
end
return string.format("%08x",h)
end
function Network.Request(url,customHeaders,maxRedirects)
if not ExecutorHttp then return nil,"No HTTP"end
maxRedirects=maxRedirects or 5
local currentUrl=url
for _=1,maxRedirects do
local headers={
["User-Agent"]=CONFIG.MobileUserAgent,
["Accept"]="*/*",
["Accept-Language"]="fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7"
}
if customHeaders then
for k,v in pairs(customHeaders)do
headers[k]=v
end
end
local ok,res=pcall(ExecutorHttp,{
Url=currentUrl,
Method="GET",
Headers=headers
})
if not ok or not res then
return nil,"HTTP request failed",currentUrl
end
local code=tonumber(res.StatusCode)or 0
if code >=300 and code < 400 and res.Headers then
local loc=res.Headers["Location"]or res.Headers["location"]
if loc and loc ~=""then
currentUrl=Network.ResolveUrl(currentUrl,loc)
else
break
end
elseif code >=200 and code < 300 then
return res.Body,nil,currentUrl,res.Headers
else
return nil,"HTTP ".. tostring(code),currentUrl
end
end
return nil,"Max redirects reached",currentUrl
end
function Network.GetJson(url,customHeaders)
