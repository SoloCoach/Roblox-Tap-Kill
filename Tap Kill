local jitter0=Vector3.new(math.random()- 0.5,math.random()- 0.5,math.random()- 0.5)* 1.4
local jitter1=Vector3.new(math.random()- 0.5,math.random()- 0.5,math.random()- 0.5)* 1.4
arc.A0.Position=(rot * arc.Base0)+ jitter0
arc.A1.Position=(rot * arc.Base1)+ jitter1
arc.Beam.CurveSize0=(math.random()- 0.5)*(3.0 + speedRatio * 3.0)
arc.Beam.CurveSize1=(math.random()- 0.5)*(3.0 + speedRatio * 3.0)
arc.Beam.Width0=0.32 +(speedRatio * 0.18)
end
end)
end
