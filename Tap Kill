local function evalBipedGait(phase,speedBlend,runBlend)
local strideZ=lerpNum(1.85,2.70,runBlend)*(0.45 + 0.55 * speedBlend)
local liftY=lerpNum(0.95,1.55,runBlend)*(0.35 + 0.65 * speedBlend)
local swing=math.sin(phase)
local cosP=math.cos(phase)
local pz=0.55 - swing * strideZ * 0.5
local py,footPitch
if cosP > 0 then
py=0.52 + math.sin(math.acos(clamp(swing,-1,1)))* liftY
footPitch=lerpNum(8.0,14.0,runBlend)* smoothstep(cosP)
else
local push=smoothstep(clamp(-swing,0,1))
footPitch=-lerpNum(5.0,10.0,runBlend)* push
py=0.52 + 2.65 * math.sin(math.rad(math.max(0,-footPitch)))
end
return pz,py,footPitch
end
