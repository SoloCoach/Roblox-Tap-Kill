task.spawn(function()
while screenGui and screenGui.Parent do
if SState.isPlaying and SState.currentSound and SState.currentSound.IsPlaying then
local pos=SState.currentSound.TimePosition or 0
local physLen=SState.currentSound.TimeLength
if not physLen or physLen <=0 then physLen=30 end
local realLen=(SState.currentTrack and tonumber(SState.currentTrack.duration))or physLen
if realLen < physLen then realLen=physLen end
if realLen <=0 then realLen=180 end
local currentDisplayPos=pos
if currentDisplayPos > realLen then currentDisplayPos=realLen end
local ratio=math.clamp(currentDisplayPos / math.max(realLen,1),0,1)
if SState.prgFill then SState.prgFill.Size=UDim2.new(ratio,0,1,0)end
local curMin=math.floor(currentDisplayPos / 60)
local curSec=math.floor(currentDisplayPos % 60)
local totalMin=math.floor(realLen / 60)
local totalSec=math.floor(realLen % 60)
if SState.timeLabel then
SState.timeLabel.Text=string.format("%02d:%02d / %02d:%02d",curMin,curSec,totalMin,totalSec)
end
else
if not SState.isPlaying then
if SState.prgFill then SState.prgFill.Size=UDim2.new(0,0,1,0)end
if SState.timeLabel and not SState.isLoading then
SState.timeLabel.Text="00:00 / 00:00"
end
end
end
task.wait(0.2)
end
end)
end
