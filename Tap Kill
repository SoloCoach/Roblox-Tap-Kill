if statusClock then statusClock.Visible=true end
if rightStatus then rightStatus.Visible=true end
end
openApp=function(targetApp,onOpenCallback)
if not targetApp then return end
playSfx(6895079853,0.4)
activeRunningApp=targetApp
hideAllScreens()
local isCameraRear=(targetApp==cameraApp and CameraSystem and CameraSystem.facing=="REAR")
if targetApp ~=cameraApp then
if chassis then chassis.BackgroundTransparency=0 end
if displayScreen then displayScreen.BackgroundTransparency=0 end
if wallpaperCanvas then wallpaperCanvas.Visible=true end
if statusClock then statusClock.Visible=true end
if rightStatus then rightStatus.Visible=true end
else
if statusClock then statusClock.Visible=false end
if rightStatus then rightStatus.Visible=false end
if isCameraRear then
if chassis then chassis.BackgroundTransparency=1 end
if displayScreen then displayScreen.BackgroundTransparency=1 end
if wallpaperCanvas then wallpaperCanvas.Visible=false end
end
end
if allInstalledApps then
for _,appMeta in ipairs(allInstalledApps)do
if appMeta.getApp and appMeta.getApp()==targetApp then
for idx=#runningAppsHistory,1,-1 do
if runningAppsHistory[idx]==appMeta.id then
table.remove(runningAppsHistory,idx)
end
end
table.insert(runningAppsHistory,1,appMeta.id)
break
end
end
end
targetApp.Visible=true
targetApp.Size=UDim2.new(0.92,0,0.92,0)
targetApp.Position=UDim2.new(0.04,0,0.04,0)
targetApp.BackgroundTransparency=isCameraRear and 1 or 0.2
local targetTransparency=isCameraRear and 1 or 0
local tw=TweenService:Create(targetApp,TweenInfo.new(0.24,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{
Size=UDim2.new(1,0,1,0),
Position=UDim2.new(0,0,0,0),
BackgroundTransparency=targetTransparency
})
tw:Play()
if onOpenCallback then
task.spawn(onOpenCallback)
end
for _,appDef in pairs(AppRegistry.apps)do
if appDef.getApp and appDef.getApp()==targetApp then
if appDef.onResume then
pcall(appDef.onResume)
elseif appDef.onOpen then
pcall(appDef.onOpen)
end
break
end
end
end
closeApp=function(callback)
if activeRunningApp then
for _,appDef in pairs(AppRegistry.apps)do
if appDef.getApp and appDef.getApp()==activeRunningApp then
if appDef.onPause then
pcall(appDef.onPause)
elseif appDef.onClose then
pcall(appDef.onClose)
end
break
end
end
end
