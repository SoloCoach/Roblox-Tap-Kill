local function getHyperCoasterPoint(u,intensityMult)
u=u % 1.0
local mult=intensityMult or 1.0
local x,y,z=0,0,0
local bankRoll=0
if u < 0.12 then
local ph=u / 0.12
local ang=ph * math.pi * 0.5
x=math.cos(ang)* 24
z=math.sin(ang)* 24
y=0
bankRoll=0
elseif u < 0.28 then
local ph=(u - 0.12)/ 0.16
local liftEase=ph * ph *(3 - 2 * ph)
x=24 + ph * 36
z=24 + ph * 190
y=liftEase * 250 * mult
bankRoll=math.sin(ph * math.pi)* 0.18
elseif u < 0.40 then
local ph=(u - 0.28)/ 0.12
local dropY=250 *(1 - ph * ph)* mult
x=60 + math.sin(ph * math.pi * 0.5)* 85
z=214 + ph * 75
y=math.max(6,dropY)
bankRoll=math.sin(ph * math.pi)* 1.05
elseif u < 0.58 then
local ph=(u - 0.40)/ 0.18
local loopAng=ph * 2 * math.pi
y=6 +(1 - math.cos(loopAng))* 72 * mult
x=145 - math.sin(loopAng)* 60
z=289 - ph * 145
bankRoll=loopAng
elseif u < 0.78 then
local ph=(u - 0.58)/ 0.20
local helAng=ph * 4 * math.pi
local r=55 - ph * 18
y=12 + math.sin(ph * math.pi * 3)* 26 * mult
x=85 + math.cos(helAng)* r
z=144 - math.sin(helAng)* r
bankRoll=math.sin(helAng)* 1.35
else
local ph=(u - 0.78)/ 0.22
local brakeEase=ph *(2 - ph)
x=(1 - brakeEase)* 85 + brakeEase * 24
y=(1 - brakeEase)* 12
z=(1 - brakeEase)* 144 + brakeEase * 0
bankRoll=(1 - brakeEase)* 0.25
end
return Vector3.new(x,y,z),bankRoll
end
local function getDropTowerState(pTime,totalDuration,towerHeight)
local p=math.clamp(pTime / totalDuration,0,1)
local H_max=towerHeight or 360
local yPos=0
local yawAng=0
local stageTag="ASCENT"
if p < 0.45 then
local tau=p / 0.45
local s=tau * tau *(3 - 2 * tau)
yPos=s * H_max
yawAng=tau * math.pi * 4
stageTag="ASCENT"
elseif p < 0.56 then
yPos=H_max + math.sin(pTime * 14)* 0.15
yawAng=math.pi * 4 + math.sin(pTime * 1.8)* 0.04
stageTag="APEX"
elseif p < 0.74 then
local tDrop=(p - 0.56)* totalDuration
local gDrop=150
local freeY=H_max -(0.5 * gDrop *(tDrop * tDrop))
local brakeThresh=35
if freeY > brakeThresh then
yPos=freeY
stageTag="DROP"
else
local over=brakeThresh - freeY
yPos=math.max(3,brakeThresh -(over * 0.22))
stageTag="BRAKE"
end
yawAng=math.pi * 4
elseif p < 0.90 then
local tauBrake=(p - 0.74)/ 0.16
local ease=(1 - tauBrake)^ 2.2
yPos=math.max(0.5,35 * ease)
yawAng=math.pi * 4
stageTag="BRAKE"
else
yPos=0
yawAng=math.pi * 4
stageTag="DOCK"
end
return yPos,yawAng,stageTag
end
local function getTopSpinState(pTime,totalDuration)
local p=math.clamp(pTime / totalDuration,0,1)
local armAngle,gondolaAngle,stageTag=0,0,"SWING"
if p < 0.25 then
local tau=p / 0.25
local amp=math.rad(45)* tau
armAngle=math.sin(pTime * 2.8)* amp
gondolaAngle=-armAngle * 0.6
stageTag="SWING"
elseif p < 0.45 then
local tau=(p - 0.25)/ 0.20
armAngle=math.rad(45)+ tau * math.rad(135)
gondolaAngle=math.sin(pTime * 3)* math.rad(30)
stageTag="APEX"
elseif p < 0.75 then
armAngle=pTime * 2.5
gondolaAngle=pTime * 4.2
stageTag="INVERT"
else
local tau=(p - 0.75)/ 0.25
local decay=(1 - tau)^ 1.8
armAngle=math.sin(pTime * 2)* math.rad(60)* decay
gondolaAngle=-armAngle * decay
stageTag="DAMP"
end
return armAngle,gondolaAngle,stageTag
end
local function getWaveSwingerState(pTime,totalDuration)
local p=math.clamp(pTime / totalDuration,0,1)
local speedNorm=0
if p < 0.22 then
speedNorm=p / 0.22
elseif p < 0.80 then
speedNorm=1.0
else
speedNorm=1.0 -((p - 0.80)/ 0.20)
end
local rotSpeed=speedNorm * 1.8
local tiltAngle=math.rad(18)* speedNorm
local liftHeight=30 * speedNorm
local swingRad=14 + 11 *(speedNorm ^ 1.6)
return rotSpeed,tiltAngle,liftHeight,swingRad
end
local function getGiantBoosterState(pTime,totalDuration)
local p=math.clamp(pTime / totalDuration,0,1)
local armSpinSpeed=(p < 0.2 and(p / 0.2))or((p > 0.8 and(1 -(p - 0.8)/ 0.2))or 1.0)
local rotAng=pTime * 1.6 * armSpinSpeed
local armLen=42
return rotAng,armLen
end
local function getEnterpriseState(pTime,totalDuration)
local p=math.clamp(pTime / totalDuration,0,1)
local spinRate=(p < 0.22 and(p / 0.22))or((p > 0.82 and(1 -(p - 0.82)/ 0.18))or 1.0)
local tiltProgress=0
if p < 0.22 then
tiltProgress=0
elseif p < 0.45 then
local tau=(p - 0.22)/ 0.23
tiltProgress=tau * tau *(3 - 2 * tau)
elseif p < 0.80 then
tiltProgress=1.0
else
local tau=(p - 0.80)/ 0.20
tiltProgress=1.0 -(tau * tau *(3 - 2 * tau))
end
local tiltAngle=tiltProgress * math.rad(86)
local spinAngle=pTime * 3.5 * spinRate
local wheelRad=26
return spinAngle,tiltAngle,wheelRad
end
local function getGiantDiscoveryState(pTime,totalDuration,maxAngleDeg)
local p=math.clamp(pTime / totalDuration,0,1)
local maxTargetRad=math.rad(maxAngleDeg or 125)
local armLength=62
local swingFreq=0.55
local stageTag="SWING"
local peakAmp=0
if p < 0.30 then
local tau=p / 0.30
peakAmp=math.rad(25)+(maxTargetRad - math.rad(25))*(tau * tau)
stageTag="PUMP"
elseif p < 0.75 then
peakAmp=maxTargetRad
stageTag="INVERT"
else
local tau=(p - 0.75)/ 0.25
local decay=(1 - tau)^ 1.8
peakAmp=maxTargetRad * decay
stageTag="DAMP"
end
local theta=peakAmp * math.sin(pTime * swingFreq * 2 * math.pi)
local discSpin=pTime * 2.0
return theta,armLength,discSpin,stageTag
end
local function getBreakdanceState(pTime,totalDuration)
local p=math.clamp(pTime / totalDuration,0,1)
local speedMult=(p < 0.18 and(p / 0.18))or((p > 0.82 and(1 -(p - 0.82)/ 0.18))or 1.0)
local mainTilt=math.rad(7.5)
