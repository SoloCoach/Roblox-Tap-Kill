local bossPos=BossState.PrimaryPart.Position
local speedMult=BossState.IsPhase3 and 1.55 or(BossState.IsPhase2 and 1.30 or 1.0)
if BossState.CurrentAIState=="StalkingHover"then
stateTimer=stateTimer + dt
orbitAngle=orbitAngle +(dt * 0.70 * speedMult)
local targetHoverPos=playerPos + Vector3.new(
math.cos(orbitAngle)* CONFIG.HoverRadius,
CONFIG.HoverAltitude,
math.sin(orbitAngle)* CONFIG.HoverRadius
)
targetHoverPos=enforceAntiClipping(targetHoverPos,CONFIG.MinGroundAltitude)
local moveDir=(targetHoverPos - bossPos)
local dist=moveDir.Magnitude
local stepSpeed=CONFIG.HoverSpeed * speedMult * dt
local newPos=dist > stepSpeed and(bossPos + moveDir.Unit * stepSpeed)or targetHoverPos
newPos=enforceAntiClipping(newPos,CONFIG.MinGroundAltitude)
local orbitTangent=Vector3.new(-math.sin(orbitAngle),0,math.cos(orbitAngle)).Unit
local bankAngle=math.rad(-22 * speedMult)
BossState.PrimaryPart.CFrame=CFrame.lookAt(newPos,newPos + orbitTangent)* CFrame.Angles(0,0,bankAngle)
local maxHoverTime=BossState.IsPhase3 and 2.0 or(BossState.IsPhase2 and 2.6 or 3.6)
if stateTimer >=maxHoverTime then
stateTimer=0
local choice=math.random(1,100)
if choice <=35 then
BossState.CurrentAIState="DiveBomb"
elseif choice <=70 then
BossState.CurrentAIState="DracarysSweep"
else
BossState.CurrentAIState="GroundedCombat"
end
end
elseif BossState.CurrentAIState=="DiveBomb"then
local climbStartPos=BossState.PrimaryPart.Position
