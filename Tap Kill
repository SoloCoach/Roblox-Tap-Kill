local hint=unitV3(pole or UNIT_Z,UNIT_Z)
local xAx=yAx:Cross(hint)
if xAx.Magnitude < 1e-4 then
local alt=(math.abs(yAx.Z)< 0.9)and Vector3.new(0,0,-1)or UNIT_X
xAx=yAx:Cross(alt)
end
xAx=xAx.Unit
local zAx=xAx:Cross(yAx).Unit
local cf=CFrame.fromMatrix(mid,xAx,yAx,zAx)
if twistDeg and math.abs(twistDeg)> 1e-4 then
cf=cf * cfDeg(0,twistDeg,0)
end
return cf
end
