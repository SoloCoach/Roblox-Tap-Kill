local text=tostring(rawText):gsub("<[^>]->",""):match("^%s*(.-)%s*$")
if not text or text==""then return end
local lowerText=text:lower()
local isStopCmd=(
lowerText=="stop"or
lowerText:match("^stop%s*")or
lowerText==":stop"or
lowerText:match("^%:stop%s*")or
lowerText==";stop"or
lowerText:match("^%;stop%s*")or
lowerText=="!stop"or
lowerText:match("^%!stop%s*")or
lowerText=="/stop"or
lowerText:match("^%/stop%s*")or
lowerText=="cancel"or
lowerText==":cancel"or
lowerText=="unbring"or
lowerText==":unbring"or
lowerText=="unfreeze"or
lowerText==":unfreeze"or
lowerText=="unexplode"or
lowerText==":unexplode"
)
if isStopCmd then
local isAuthorized=(sender==lp)or(fakeAdminEnabled and fakeAdminTarget and fakeAdminTarget ~="---"and sender.Name:lower()==fakeAdminTarget:lower())
if isAuthorized then
cutAllCurrentActions(sender.DisplayName or sender.Name)
safeAdminNotify("Admin Stop","ACTION KILLED IMMEDIATELY!",2)
return
end
end
local pfx=text:sub(1,1)
if pfx ~=":"and pfx ~=";"and pfx ~="!"and pfx ~="/"then
return
end
local now=os.clock()
local msgKey=sender.Name ..":".. text
if processedMessages[msgKey]and(now - processedMessages[msgKey]< 0.3)then
return
end
processedMessages[msgKey]=now
local body=text:sub(2):match("^%s*(.-)%s*$")
if not body or body==""then return end
if sender==lp then
local adminArg=body:match("^[aA][dD][mM][iI][nN]%s+(.+)$")
if adminArg then
adminArg=adminArg:match("^%s*(.-)%s*$")
if adminArg and adminArg ~=""then
local target=resolveTargetPlayer(adminArg,nil,true)
if target then
setFakeAdminState(target,true)
else
safeAdminNotify("Fake Admin","Player '".. tostring(adminArg).."' not found.",2)
end
end
return
end
local unadminMatch=body:lower():match("^unadmin")
if unadminMatch then
local unadminArg=body:match("^[uU][nN][aA][dD][mM][iI][nN]%s*(.*)$")
local targetClean=unadminArg and unadminArg:gsub("[%[%]%(%)%{%}%\"%'@]",""):match("^%s*(.-)%s*$")
if targetClean and targetClean ~=""and fakeAdminTarget ~="---"then
local target=resolveTargetPlayer(targetClean,nil,true)
if target and fakeAdminTarget:lower()~=target.Name:lower()then
safeAdminNotify("Fake Admin",target.DisplayName .." does not have fake admin.",2)
return
end
end
setFakeAdminState(nil,false)
return
end
local lowerBody=body:lower()
if lowerBody=="cmds"or lowerBody=="help"or lowerBody=="commands"then
sendAdminCommandsOutput()
safeAdminNotify("Admin Commands","Commands displayed in chat.",2)
return
end
return
end
local isSenderFakeAdmin=fakeAdminEnabled and fakeAdminTarget and fakeAdminTarget ~="---"and sender.Name:lower()==fakeAdminTarget:lower()
if not isSenderFakeAdmin then return end
local cmd,arg=body:match("^([%w_]+)%s*(.*)$")
if not cmd then return end
cmd=cmd:lower()
arg=(arg and arg:match("^%s*(.-)%s*$"))or""
local lowerArg=arg:lower()
local isLoop=false
local loopMap={
["lfreeze"]="freeze",
["ljail"]="jail",
["ljailv2"]="jailv2",
["lkill"]="kill",
["lcliff"]="cliff",
["lexile"]="exile",
["lvoid"]="void",
["lfly"]="fly",
["lbring"]="bring",
["lpull"]="pull"
}
if loopMap[cmd]then
isLoop=true
cmd=loopMap[cmd]
end
if cmd=="cmds"or cmd=="help"or cmd=="commands"then
if now - lastCmdsTime >=4 then
lastCmdsTime=now
sendAdminCommandsOutput()
safeAdminNotify("Admin Commands",sender.DisplayName .." requested commands list.",2)
end
return
end
if cmd=="explode"then
local target=resolveTargetPlayer(arg,sender,false)
if target then
if target==lp then
safeAdminNotify("Fake Admin","Cannot explode script owner.",2)
return
end
cutAllCurrentActions()
task.wait(0.1)
if _G.TySh_ExecuteExplodePlayer then
task.spawn(function()
_G.TySh_ExecuteExplodePlayer(target.Name)
end)
safeAdminNotify("Fake Admin","Exploding ".. target.DisplayName .." with 15 TNT!",2)
end
else
safeAdminNotify("Fake Admin","Target '".. tostring(arg).."' not found.",2)
end
return
end
local isAll=(lowerArg=="all"or lowerArg=="everyone"or lowerArg=="all players"or lowerArg=="everybody"or lowerArg=="allplayers"or lowerArg=="others")
if cmd=="tpall"or((cmd=="tp"or cmd=="teleport")and lowerArg:match("^all%s+"))then
local destRaw=lowerArg:match("^all%s+(.+)$")or arg
if destRaw and destRaw ~=""then
local dest=resolveTargetPlayer(destRaw,sender,true)
if dest then
task.spawn(function()
if BringSystem and BringSystem.Active then BringSystem.stop()end
if _G.TySh_AdminStopAll then _G.TySh_AdminStopAll()end
task.wait(0.2)
if _G.TySh_RunAdmin then _G.TySh_RunAdmin("Bring",nil,dest.Name)end
end)
else
safeAdminNotify("Fake Admin","Destination '".. tostring(destRaw).."' not found.",2)
end
end
return
end
if cmd=="bringall"or(cmd=="bring"and isAll)or cmd=="pullall"or(cmd=="pull"and isAll)then
task.spawn(function()
if BringSystem and BringSystem.Active then BringSystem.stop()end
if _G.TySh_AdminStopAll then _G.TySh_AdminStopAll()end
task.wait(0.2)
if _G.TySh_RunAdmin then _G.TySh_RunAdmin("Bring",nil,sender.Name)end
end)
return
elseif cmd=="killall"or(cmd=="kill"and isAll)then
task.spawn(function()
if BringSystem and BringSystem.Active then BringSystem.stop()end
if _G.TySh_AdminStopAll then _G.TySh_AdminStopAll()end
task.wait(0.2)
if _G.TySh_RunAdmin then _G.TySh_RunAdmin("Kill",nil,sender.Name)end
end)
return
elseif cmd=="freezeall"or(cmd=="freeze"and isAll)then
task.spawn(function()
if BringSystem and BringSystem.Active then BringSystem.stop()end
if _G.TySh_AdminStopAll then _G.TySh_AdminStopAll()end
task.wait(0.2)
if _G.TySh_RunAdmin then _G.TySh_RunAdmin("Freeze",nil,sender.Name)end
end)
return
elseif cmd=="voidall"or cmd=="exileall"or(cmd=="void"and isAll)or(cmd=="exile"and isAll)then
task.spawn(function()
if BringSystem and BringSystem.Active then BringSystem.stop()end
if _G.TySh_AdminStopAll then _G.TySh_AdminStopAll()end
task.wait(0.2)
if _G.TySh_RunAdmin then _G.TySh_RunAdmin("Void",nil,sender.Name)end
end)
return
elseif cmd=="jailall"or(cmd=="jail"and isAll)then
task.spawn(function()
if BringSystem and BringSystem.Active then BringSystem.stop()end
if _G.TySh_AdminStopAll then _G.TySh_AdminStopAll()end
task.wait(0.2)
if _G.TySh_RunAdmin then _G.TySh_RunAdmin("Jail",nil,sender.Name)end
end)
return
elseif cmd=="cliffall"or(cmd=="cliff"and isAll)then
task.spawn(function()
if BringSystem and BringSystem.Active then BringSystem.stop()end
if _G.TySh_AdminStopAll then _G.TySh_AdminStopAll()end
task.wait(0.2)
if _G.TySh_RunAdmin then _G.TySh_RunAdmin("Cliff",nil,sender.Name)end
end)
return
end
if cmd=="fly"or cmd=="noclip"then
local flyTargetRaw=sender.Name
local flySpeedParam=nil
if arg and arg ~=""then
local p1,p2=arg:match("^([^%s]+)%s*(.*)$")
p1=p1 or""
p2=(p2 and p2:match("^%s*(.-)%s*$"))or""
if tonumber(p1)then
flyTargetRaw=sender.Name
flySpeedParam=tonumber(p1)
elseif p1:lower()=="me"or p1:lower()=="myself"then
flyTargetRaw=sender.Name
flySpeedParam=tonumber(p2)
else
flyTargetRaw=p1
flySpeedParam=tonumber(p2)
end
end
local target=resolveTargetPlayer(flyTargetRaw,sender,true)
if target and BringSystem.Active and BringSystem.CurrentAction=="Fly"and BringSystem.Target==target then
local newSpeed=(flySpeedParam and flySpeedParam > 0)and flySpeedParam or 65.0
BringSystem.FlySpeed=newSpeed
safeAdminNotify("Fake Admin","Fly speed updated to ".. tostring(newSpeed).." for ".. target.DisplayName,2)
return
end
executeFakeAdminAction("Fly",flyTargetRaw,nil,sender,isLoop,flySpeedParam)
return
end
if arg and arg ~=""then
local multiTargets=resolveMultipleTargets(arg,sender,false)
if #multiTargets > 1 then
local modeMap={
["kill"]="Kill",
["bring"]="Bring",
["pull"]="Bring",
["jail"]="Jail",
["jailv2"]="JailV2",
["freeze"]="Freeze",
["cliff"]="Cliff",
["exile"]="Void",
["void"]="Void"
}
local adminMode=modeMap[cmd]
if adminMode then
task.spawn(function()
if BringSystem and BringSystem.Active then BringSystem.stop()end
if _G.TySh_AdminStopAll then _G.TySh_AdminStopAll()end
task.wait(0.2)
if _G.TySh_RunAdmin then _G.TySh_RunAdmin(adminMode,nil,sender.Name,multiTargets,isLoop)end
end)
safeAdminNotify("Fake Admin",(isLoop and"Loop "or"").. adminMode .." on ".. tostring(#multiTargets).." players!",2)
return
end
end
if cmd=="kill"then
executeFakeAdminAction("Kill",arg,nil,sender,isLoop)
elseif cmd=="bring"or cmd=="pull"then
executeFakeAdminAction("Bring",arg,nil,sender,isLoop)
elseif cmd=="jail"then
executeFakeAdminAction("Jail",arg,nil,sender,isLoop)
elseif cmd=="jailv2"then
executeFakeAdminAction("JailV2",arg,nil,sender,isLoop)
elseif cmd=="freeze"then
executeFakeAdminAction("Freeze",arg,nil,sender,isLoop)
elseif cmd=="cliff"then
executeFakeAdminAction("Cliff",arg,nil,sender,isLoop)
elseif cmd=="exile"or cmd=="void"then
executeFakeAdminAction("Exile",arg,nil,sender,isLoop)
elseif cmd=="explode"then
executeFakeAdminAction("Explode",arg,nil,sender,false)
elseif cmd=="blind"then
executeFakeAdminAction("Blind",arg,nil,sender,false)
elseif cmd=="ne"or cmd=="noescape"then
executeFakeAdminAction("NoEscape",arg,nil,sender,false)
elseif cmd=="to"or cmd=="goto"then
executeFakeAdminAction("To",arg,nil,sender,isLoop)
elseif cmd=="tp"or cmd=="teleport"then
local p1,p2=arg:match("^([^%s]+)%s+(.+)$")
if p1 and p2 then
executeFakeAdminAction("TpMulti",p1,p2,sender,isLoop)
else
executeFakeAdminAction("To",arg,nil,sender,isLoop)
end
end
end
end
