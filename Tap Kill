return
end
local clean=hInput.Text:gsub("%s+","")
if #clean < 3 or #clean > 20 then
hStatusLbl.TextColor3=Color3.fromRGB(255,69,58)
hStatusLbl.Text="Username must be 3-20 characters!"
return
end
if not clean:find("^@")then clean="@".. clean end
if clean==phoneConfig.username then
hStatusLbl.TextColor3=Color3.fromRGB(255,149,0)
hStatusLbl.Text="Enter a new username different from current!"
return
end
playSfx(6895079853,0.4)
hSaveBtn.Text="UPDATING ON CLOUD..."
hSaveBtn.Active=false
TyShCloud.changeUsername(clean,function(success,data)
hSaveBtn.Active=true
if success and data and data.newUsername then
phoneConfig.username=data.newUsername
phoneConfig.lastUsernameChange=os.time()
saveConfig()
if setHandle then setHandle.Text=data.newUsername .." - TySh VIP"end
if profileNameLabel then profileNameLabel.Text=data.newUsername end
if rowHandle and rowHandle.setRightText then rowHandle.setRightText(data.newUsername)end
hStatusLbl.TextColor3=Color3.fromRGB(48,209,88)
