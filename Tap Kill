return
end
local houseCFrame=getHouseSpawnCFrame(lot)
if not houseCFrame then
AntiBangState.isPunishing=false
return
end
fireHouseBan(trollPlayer)
local originalCFrame=myHRP.CFrame
local travelDistance=(originalCFrame.Position - houseCFrame.Position).Magnitude
local maxStay=math.clamp(
AntiBangState.baseMaxStay + travelDistance * AntiBangState.secondsPerStud,
AntiBangState.baseMaxStay,
AntiBangState.maxStayCap
)
myHRP.AssemblyLinearVelocity=Vector3.zero
myHRP.AssemblyAngularVelocity=Vector3.zero
myHRP.CFrame=houseCFrame
local startTime=tick()
local lastFire=startTime
local arrived=false
local arrivedAt=0
local ejected=false
while true do
task.wait()
local now=tick()
local elapsed=now - startTime
local currentHRP=lp.Character and lp.Character:FindFirstChild(_K[55])
if not currentHRP then break end
if(currentHRP.Position - houseCFrame.Position).Magnitude > 6 then
currentHRP.AssemblyLinearVelocity=Vector3.zero
currentHRP.CFrame=houseCFrame
end
if(now - lastFire)>=AntiBangState.banRefireInterval then
lastFire=now
fireHouseBan(trollPlayer)
end
local dist=getDistanceTo(trollPlayer,currentHRP)
if not trollPlayer.Parent then
ejected=true
break
elseif dist==nil then
if arrived then ejected=true end
elseif not arrived and dist <=AntiBangState.arrivedDistance then
arrived=true
arrivedAt=now
lastFire=now
fireHouseBan(trollPlayer)
elseif arrived and dist >=AntiBangState.ejectedDistance then
ejected=true
end
if ejected and arrived then break end
if arrived and(now - arrivedAt)>=AntiBangState.postArrivalHold then break end
if elapsed >=maxStay then break end
end
local currentHRP=lp.Character and lp.Character:FindFirstChild(_K[55])
if currentHRP then
currentHRP.AssemblyLinearVelocity=Vector3.zero
currentHRP.AssemblyAngularVelocity=Vector3.zero
currentHRP.CFrame=originalCFrame
end
tyshSendNotification({
Title="Anti-Bang",
Text="Punished @".. trollPlayer.Name .." (".. tostring(reason)..")",
Duration=3
})
AntiBangState.targetHistory[trollPlayer]=nil
task.wait(1.0)
AntiBangState.isPunishing=false
end)
end
