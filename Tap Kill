local diveSpeed=BossState.IsPhase3 and CONFIG.DiveSpeedPhase3 or(BossState.IsPhase2 and CONFIG.DiveSpeedPhase2 or CONFIG.DiveSpeedPhase1)
playSound(CONFIG.Sounds.DiveWhoosh,1.35,false,BossState.PrimaryPart)
