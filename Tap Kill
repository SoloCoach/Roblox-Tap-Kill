local p=climbStartPos:Lerp(climbTargetPos,a)
BossState.PrimaryPart.CFrame=CFrame.lookAt(p,playerPos)
RunService.RenderStepped:Wait()
end
local impactGroundY=getGroundAltitudeUnder(playerPos)
local targetImpactPoint=Vector3.new(playerPos.X,impactGroundY + CONFIG.GroundImpactOffset,playerPos.Z)
