})
if #videos >=maxResults then return videos end
end
end
end
end
local ytHtml=Network.Request("https://www.youtube.com/results?search_query=".. encoded,{
["User-Agent"]=CONFIG.DesktopUserAgent
})
if ytHtml then
local seen={}
for vidId,titleText in string.gmatch(ytHtml,'"videoId":"([%w%-_]+)".-"title":%{"runs":%[%{%s*"text":"([^"]+)"')do
if not seen[vidId]and #vidId==11 then
