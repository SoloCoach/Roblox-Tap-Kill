end
function Network.ExtractDomain(url)
local clean=string.gsub(tostring(url or""),"^https?://","")
clean=string.gsub(clean,"^www%.","")
return string.match(clean,"^([^/%?#]+)")or clean
end
function Network.ExtractOrigin(url)
local origin=string.match(tostring(url or""),"^(https?://[^/]+)")
return origin or("https://".. Network.ExtractDomain(url))
end
function Network.ResolveUrl(baseUrl,href)
href=string.match(tostring(href or""),"^%s*(.-)%s*$")or""
if href==""or string.sub(href,1,1)=="#"or string.find(href,"^javascript:")then
return nil
end
if string.find(href,"^https?://")or string.find(href,"^youtube://")or string.find(href,"^search://")then
return href
end
if string.sub(href,1,2)=="//"then
return"https:".. href
end
local origin=Network.ExtractOrigin(baseUrl)
if string.sub(href,1,1)=="/"then
return origin .. href
end
local baseDir=string.match(tostring(baseUrl or""),"^(https?://.+/)")or(origin .."/")
return baseDir .. href
end
function Network.FormatTime(seconds)
seconds=math.max(0,math.floor(tonumber(seconds)or 0))
local mins=math.floor(seconds / 60)
local secs=seconds % 60
return string.format("%d:%02d",mins,secs)
end
function Network.FormatViews(count)
