local playerClonesPiP={}
local function loadMapGeometry()
if mapClonesLoaded then return end
mapClonesLoaded=true
local rootPart=lp and lp.Character and lp.Character:FindFirstChild(_K[55])
local origin=rootPart and rootPart.Position or Vector3.zero
local function cloneObject(obj)
if not obj or not obj.Parent then return end
if Players:GetPlayerFromCharacter(obj)or obj:IsA("Terrain")or obj:IsA("Camera")then return end
if obj:IsA("BasePart")and(obj.Position - origin).Magnitude <=RENDER_RADIUS then
obj.Archivable=true
local c1=obj:Clone()
local c2=obj:Clone()
if c1 then c1.Parent=mainWorld end
if c2 then c2.Parent=pipWorld end
elseif obj:IsA("Model")then
local modelPivot=obj:GetPivot().Position
if(modelPivot - origin).Magnitude <=RENDER_RADIUS then
obj.Archivable=true
local c1=obj:Clone()
local c2=obj:Clone()
if c1 then c1.Parent=mainWorld end
if c2 then c2.Parent=pipWorld end
end
elseif obj:IsA("Folder")then
for _,sub in ipairs(obj:GetChildren())do
cloneObject(sub)
end
end
end
for _,obj in ipairs(Workspace:GetChildren())do
cloneObject(obj)
end
end
local function syncPlayersInViewports()
for _,plr in ipairs(Players:GetPlayers())do
local char=plr.Character
if char and char:FindFirstChild(_K[55])then
char.Archivable=true
local isLocal=(plr==lp)
if isLocal then
if not CamState.isFlipped then
if playerClonesMain[plr]and playerClonesMain[plr].Parent then
playerClonesMain[plr].Parent=nil
end
if not playerClonesPiP[plr]then
local cPiP=char:Clone()
if cPiP then
cPiP.Parent=pipWorld
playerClonesPiP[plr]=cPiP
end
elseif playerClonesPiP[plr].Parent ~=pipWorld then
playerClonesPiP[plr].Parent=pipWorld
end
else
if not playerClonesMain[plr]then
local cMain=char:Clone()
if cMain then
cMain.Parent=mainWorld
playerClonesMain[plr]=cMain
end
elseif playerClonesMain[plr].Parent ~=mainWorld then
playerClonesMain[plr].Parent=mainWorld
end
if playerClonesPiP[plr]and playerClonesPiP[plr].Parent then
playerClonesPiP[plr].Parent=nil
end
end
else
if not playerClonesMain[plr]then
local cMain=char:Clone()
if cMain then
cMain.Parent=mainWorld
playerClonesMain[plr]=cMain
end
end
end
local cloneM=playerClonesMain[plr]
local cloneP=playerClonesPiP[plr]
for _,part in ipairs(char:GetDescendants())do
if part:IsA("BasePart")then
if cloneM and cloneM.Parent then
local targetM=cloneM:FindFirstChild(part.Name,true)
if targetM and targetM:IsA("BasePart")then
targetM.CFrame=part.CFrame
end
end
if cloneP and cloneP.Parent then
local targetP=cloneP:FindFirstChild(part.Name,true)
if targetP and targetP:IsA("BasePart")then
targetP.CFrame=part.CFrame
end
end
end
end
end
end
end
