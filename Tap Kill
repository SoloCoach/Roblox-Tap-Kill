function AppRegistry.register(selfOrDef,maybeDef)
local appDef=(type(selfOrDef)=="table"and maybeDef)and maybeDef or selfOrDef
if not appDef or not appDef.id then return end
AppRegistry.apps[appDef.id]=appDef
for i,id in ipairs(AppRegistry.order)do
if id==appDef.id then
table.remove(AppRegistry.order,i)
