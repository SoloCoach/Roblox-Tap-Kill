local function getFluentAccentColor()
local mode=TySh_SavedSettings.ToggleAccentColor or"Auto"
local leftTheme,rightTheme=tyshResolveThemeModes()
local isDarkMono=(rightTheme=="Dark Mono")or(leftTheme=="Dark Mono")
if mode=="Auto"or mode=="Auto (Adapt to Category)"then
local catCol=TYSH_CATEGORY_COLOR or Color3.fromRGB(160,50,240)
if catCol.R > 0.9 and catCol.G > 0.9 and catCol.B > 0.9 then
return isDarkMono and Color3.fromRGB(235,235,246)or Color3.fromRGB(160,50,240)
end
local h,s,v=catCol:ToHSV()
s=math.clamp(s * 1.25,0.70,0.90)
v=math.clamp(v,0.90,1.0)
return Color3.fromHSV(h,s,v)
elseif mode=="Purple"or mode=="Purple Neon"then
return Color3.fromRGB(160,50,240)
elseif mode=="Red"or mode=="Crimson Blood"then
return Color3.fromRGB(235,45,60)
elseif mode=="Blue"or mode=="Cyberpunk Blue"then
return Color3.fromRGB(45,160,255)
elseif mode=="Green"or mode=="Emerald Green"then
return Color3.fromRGB(45,215,105)
elseif mode=="Yellow"or mode=="Gold Amber"then
return Color3.fromRGB(250,195,40)
elseif mode=="White"or mode=="Clean White"then
return Color3.fromRGB(245,245,250)
end
return Color3.fromRGB(160,50,240)
end
