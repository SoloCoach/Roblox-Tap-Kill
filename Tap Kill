local function newOscillator(hysteresis)
return{extreme=nil,dir=0,reversals={},h=hysteresis}
end
local function feedOscillator(osc,value,now)
local h=osc.h
if osc.extreme==nil then
osc.extreme=value
osc.dir=0
elseif osc.dir==0 then
if value - osc.extreme > h then
osc.dir=1
osc.extreme=value
elseif osc.extreme - value > h then
osc.dir=-1
osc.extreme=value
end
elseif osc.dir==1 then
if value > osc.extreme then
osc.extreme=value
elseif osc.extreme - value > h then
osc.dir=-1
osc.extreme=value
table.insert(osc.reversals,now)
end
else
if value < osc.extreme then
osc.extreme=value
elseif value - osc.extreme > h then
osc.dir=1
osc.extreme=value
table.insert(osc.reversals,now)
end
end
local kept={}
for _,t in ipairs(osc.reversals)do
if(now - t)<=AntiBangState.oscillationWindow then
table.insert(kept,t)
end
end
osc.reversals=kept
return #kept
end
