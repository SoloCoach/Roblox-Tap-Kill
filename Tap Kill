local function poseLimbs(poses,pelvisCF,chestCF,sig,dyR,dyL)
local poleFwd=Vector3.new(0,0,-1)
local axR,ayR,azR=sig.ankleRX,sig.ankleRY + dyR,sig.ankleRZ
local axL,ayL,azL=sig.ankleLX,sig.ankleLY + dyL,sig.ankleLZ
for _,leg in ipairs({
{1,"R",axR,ayR,azR},
{-1,"L",axL,ayL,azL},
})do
local s,suf,ax,ay,az=leg[1],leg[2],leg[3],leg[4],leg[5]
local hip=pelvisCF * Vector3.new(s * 1.45,-0.30,0.05)
local ankle=Vector3.new(ax,ay,az)
local knee=solveTwoBone(hip,ankle,3.55,3.65,Vector3.new(s * 0.35,0.12 + 0.04 * sig.walkW,-1))
poses["Thigh".. suf]=aimCenterY(hip,knee,poleFwd,0)
poses["CalfUpper".. suf]=segmentPosY(knee,ankle,0.28,poleFwd)
poses["CalfTaper".. suf]=segmentPosY(knee,ankle,0.68,poleFwd)
end
local footRBase=CFrame.new(axR,ayR + 0.33,azR)* cfDeg(sig.footPitchR,0,0)* CFrame.new(0,0,-0.60)* cfDeg(0,-45,0)
local footLRef=CFrame.new(-axL,ayL + 0.33,azL)* cfDeg(sig.footPitchL,0,0)* CFrame.new(0,0,-0.60)* cfDeg(0,-45,0)
poses.FootR=footRBase
poses.FootL=mirrorCfLeft(CFrame.new(),footLRef,"XZ")
local rChest=chestCF - chestCF.Position
local ww,rw=sig.walkW,sig.runW
local floorMinY=0.92 + math.min(dyR,dyL)
for _,arm in ipairs({
{-1,"L",sig.armSwingL,sig.elbowLiftL,sig.armBlendL,sig.armTarLX,sig.armTarLY,sig.armTarLZ,sig.elbAddLX,sig.elbAddLY,sig.elbAddLZ,sig.handPL,sig.handYL,sig.handRL},
{1,"R",sig.armSwingR,sig.elbowLiftR,sig.armBlendR,sig.armTarRX,sig.armTarRY,sig.armTarRZ,sig.elbAddRX,sig.elbAddRY,sig.elbAddRZ,sig.handPR,sig.handYR,sig.handRR},
})do
local s,suf,armSw,elbLift=arm[1],arm[2],arm[3],arm[4]
local blend,tx,ty,tz=arm[5],arm[6],arm[7],arm[8]
local ex,ey,ez=arm[9],arm[10],arm[11]
local hP,hY,hR=arm[12],arm[13],arm[14]
local sh=chestCF * Vector3.new(s * 3.05,1.55,-0.15)
local wx=s *(4.10 + 0.16 * sig.breath + 0.42 * ww + 0.45 * rw)
local wy=-2.75 + 0.36 * sig.breathLag + s * 0.14 * sig.sway *(1 - 0.5 * ww)+ elbLift *(0.75 + 0.35 * rw)+ 0.45 * rw
local wz=-2.45 - 0.22 * sig.breath + s * 0.22 * sig.swayCos *(1 - 0.5 * ww)+ 1.35 * ww - 0.45 * rw - armSw *(4.2 * ww + 1.8 * rw)
if blend > 0.001 then
wx=lerpNum(wx,tx,blend)
wy=lerpNum(wy,ty,blend)
wz=lerpNum(wz,tz,blend)
end
local wrist=chestCF * Vector3.new(wx,wy,wz)
if blend > 0.001 then
local toW=wrist - sh
local dLen=toW.Magnitude
if dLen > 6.95 then
wrist=sh + toW.Unit * 6.95
end
if wrist.Y < floorMinY then
wrist=Vector3.new(wrist.X,floorMinY,wrist.Z)
end
end
local poleVec=Vector3.new(s *(0.52 + 0.28 * rw)+ ex,0.15 + 0.20 * rw + ey,0.85 + ez)
local elb=solveTwoBone(sh,wrist,3.65,3.55,rChest * poleVec)
poses["Deltoid".. suf]=segmentPosY(sh,elb,0.18,poleFwd)
poses["Bicep".. suf]=segmentPosY(sh,elb,0.68,poleFwd)
poses["Forearm".. suf]=segmentPosY(elb,wrist,0.58,poleFwd)
local fdir=(wrist - elb).Unit
local hUp=rChest * Vector3.new(-s * 0.40,0.85,0)
local handCF=CFrame.lookAt(wrist,wrist + fdir * 2.0,hUp)
* cfDeg(3.5 * sig.breathLag + armSw * 10.0 + hP,hY,s *(-2.5 * sig.sway + hR))
local fB=handCF * Vector3.new(0,0,0.35)
local fE=handCF * Vector3.new(-s * 0.72,-0.35,-1.35)
poses["WristFist".. suf]=aimCenterY(fB,fE,handCF.UpVector,0)
local tB=handCF * Vector3.new(-s * 0.58,0.12,-0.25)
local tE=handCF * Vector3.new(-s * 1.18,-0.45,-1.82)
poses["ClawTalon".. suf]=aimCenterY(tB,tE,handCF.UpVector,0)
end
end
