local function processMessageBatch(messagesArray)
if type(messagesArray)~="table"or #messagesArray==0 then
return
end
table.sort(messagesArray,function(a,b)
local tsA=tonumber(a.timestamp)or 0
local tsB=tonumber(b.timestamp)or 0
if tsA==tsB then
return tostring(a.id or"")< tostring(b.id or"")
end
return tsA < tsB
end)
local addedCount=0
local lastSenderWasMe=false
for i=1,#messagesArray do
local msg=messagesArray[i]
local rawText=msg.text or msg.content
if rawText and #rawText > 0 then
local isMe=isSenderMe(msg.sender or msg.from or msg.userId)
local row=addBubble(rawText,isMe,msg.sender or msg.from,true,msg.id)
if row then
addedCount=addedCount + 1
if isMe then
lastSenderWasMe=true
else
playSfx(6895079853,0.35)
end
end
local msgTs=tonumber(msg.timestamp)or 0
if msgTs > ChatState.lastSyncCursor then
ChatState.lastSyncCursor=msgTs
end
end
end
if addedCount > 0 then
updateCanvasAndScroll(lastSenderWasMe)
end
end
fetchMessagesDelta=function()
if ChatState.isPolling or not ChatState.isChatOpen or not activeChatTarget then
return
end
ChatState.isPolling=true
task.spawn(function()
local target=activeChatTarget
local isGrp=activeIsGroup
local convKey=ChatState.activeConversationId
if isGrp then
TyShCloud.getGroupMessages(target,function(ok,msgs)
if ok and type(msgs)=="table"and ChatState.isChatOpen and activeChatTarget==target then
processMessageBatch(msgs)
end
ChatState.isPolling=false
end)
else
TyShCloud.getDirectMessages(target,function(ok,msgs)
if ok and type(msgs)=="table"and ChatState.isChatOpen and activeChatTarget==target then
local decodedList={}
for _,m in ipairs(msgs)do
local copy={}
for k,v in pairs(m)do copy[k]=v end
local raw=copy.text or copy.content or""
if type(raw)=="string"and string.match(raw,"^enc:")then
raw=decipherText(raw,convKey)
end
copy.text=raw
copy.content=raw
table.insert(decodedList,copy)
end
processMessageBatch(decodedList)
end
ChatState.isPolling=false
end)
end
end)
end
