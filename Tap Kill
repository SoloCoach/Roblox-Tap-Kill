elseif count >=1000 then
return string.format("%.1fK views",count / 1000)
end
return tostring(count).." views"
end
function Network.FetchImageAsset(imgUrl,forceRefresh)
if not imgUrl or imgUrl==""or not GetCustomAsset or not WriteFile or not IsFile then
return nil
end
local hash=Network.HashString(imgUrl)
local jpgPath=string.format("%s/img_%s.jpg",CONFIG.CacheDirectory,hash)
local pngPath=string.format("%s/img_%s.png",CONFIG.CacheDirectory,hash)
if not forceRefresh then
if pcall(IsFile,jpgPath)and IsFile(jpgPath)then
local ok,asset=pcall(GetCustomAsset,jpgPath)
if ok and asset then return asset end
end
if pcall(IsFile,pngPath)and IsFile(pngPath)then
local ok,asset=pcall(GetCustomAsset,pngPath)
if ok and asset then return asset end
end
end
local bytes=Network.Request(imgUrl)
if not bytes or #bytes < 256 then
return nil
end
local b1,b2=string.byte(bytes,1,2)
local isPng=(b1==0x89 and b2==0x50)
local isJpg=(b1==0xFF and b2==0xD8)
local isWebp=(string.sub(bytes,1,4)=="RIFF"and string.sub(bytes,9,12)=="WEBP")
if not(isPng or isJpg or isWebp)then
return nil
end
local targetPath=isPng and pngPath or jpgPath
local writeOk=pcall(WriteFile,targetPath,bytes)
if not writeOk then return nil end
local okAsset,customUri=pcall(GetCustomAsset,targetPath)
