local function findAttackTarget(st,hitCenter,hitRadius,preferTarget,now)
local lp=Players.LocalPlayer
local bestPlr,bestRoot,bestDist=nil,nil,hitRadius + 0.001
if preferTarget and st.targetPlayer and st.targetPlayer ~=lp then
local tp=st.targetPlayer
local cd=st.flingCooldowns[tp]or 0
local ch=tp.Character
local tr=ch and ch:FindFirstChild(_K[55])
local th=ch and ch:FindFirstChildOfClass(_K[104])
if tr and th and th.Health > 0 and now >=cd then
local d=(tr.Position - hitCenter).Magnitude
if d <=hitRadius + 6.0 and readRootVel(tr).Magnitude <=900 then
return tp,tr
end
end
end
for _,p in ipairs(Players:GetPlayers())do
