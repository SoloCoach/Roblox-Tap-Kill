local function setBrookhavenBodySize(targetPercent)
targetPercent=math.clamp(math.round(targetPercent),50,100)
local targetScale=targetPercent / 100
local char=lp.Character
local hum=char and char:FindFirstChildOfClass(_K[104])
local hScale=hum and hum:FindFirstChild("BodyHeightScale")
local currentScale=(hScale and hScale.Value)or 1.0
local Remotes=ReplicatedStorage:FindFirstChild("Remotes")or ReplicatedStorage:FindFirstChild("RE")
local incRemote=Remotes and Remotes:FindFirstChild("IncrementBodySize")
if not incRemote then
tyshSendNotification({Title="Character Scale",Text="IncrementBodySize remote not found.",Duration=3})
return
end
local diff=targetScale - currentScale
if math.abs(diff)< 0.02 then return end
local isGrowing=diff > 0
local steps=math.clamp(math.round(math.abs(diff)/ 0.05),1,10)
task.spawn(function()
for _=1,steps do
pcall(function()
incRemote:FireServer(isGrowing)
end)
task.wait(0.04)
end
end)
end
