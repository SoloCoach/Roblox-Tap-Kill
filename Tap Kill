type CandidateEntry={
node: PropStreamNode,
priorityScore: number,
}
local candidatesPool:{CandidateEntry}=table.create(45)
local function flushTRexNetworkTick()
if not IsActive or #ActiveNodesList==0 then return end
local candidateCount=0
for _,node in ipairs(ActiveNodesList)do
node.ticksSinceLastSent +=1
node.accumulatedPriority +=node.weight
if node.inFlight then
continue
end
local targetCF=node.currTargetCF
local lastCF=node.lastSentCF
local dp=targetCF.Position - lastCF.Position
local distSq=dp.X * dp.X + dp.Y * dp.Y + dp.Z * dp.Z
local trace=getRotationTrace(lastCF,targetCF)
local isPosDirty=distSq > POS_EPSILON_SQ
local isRotDirty=trace < ROT_TRACE_THRESHOLD
local isForcedKeyframe=(node.ticksSinceLastSent >=FORCED_KEYFRAME_TICKS)and(distSq > 1e-6 or trace < 2.99999)
if(isPosDirty or isRotDirty or isForcedKeyframe)and(node.accumulatedPriority >=1.0 or isForcedKeyframe)then
local normPosErr=distSq / POS_EPSILON_SQ
local normRotErr=math.max(0,(3.0 - trace)* 600)
local kinematicError=1 + math.sqrt(normPosErr + normRotErr)
local priorityScore=node.accumulatedPriority * node.weight * kinematicError
if isForcedKeyframe then
priorityScore +=10000
end
candidateCount +=1
candidatesPool[candidateCount]={
node=node,
priorityScore=priorityScore,
}
end
end
if candidateCount==0 then return end
if candidateCount > MAX_RPCS_PER_TICK then
table.sort(candidatesPool,function(a: CandidateEntry,b: CandidateEntry): boolean
return a.priorityScore > b.priorityScore
end)
end
local sendCount=math.min(candidateCount,MAX_RPCS_PER_TICK)
for i=1,sendCount do
local entry=candidatesPool[i]
local node=entry.node
local outgoingCF=node.currTargetCF +(node.currVelocity * PREDICTIVE_LEAD_TIME)
node.lastSentCF=outgoingCF
node.accumulatedPriority=0
node.ticksSinceLastSent=0
dispatchRemoteNonBlocking(node,outgoingCF)
end
end
