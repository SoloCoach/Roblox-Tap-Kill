local function solveArachnidLimb(
hipPos: Vector3,
footPos: Vector3,
side: number,
femurLen: number,
tibiaLen: number,
twitchAngle: number
):(CFrame,CFrame,CFrame)
local toFoot=footPos - hipPos
local dist=math.clamp(toFoot.Magnitude,1.5,(femurLen + tibiaLen)* 0.96)
local dirUnit=(toFoot.Magnitude > 0.01)and toFoot.Unit or Vector3.new(0,-1,0)
local cosAlpha=math.clamp(
(femurLen * femurLen + dist * dist - tibiaLen * tibiaLen)/(2 * femurLen * dist),
-0.98,
0.98
)
local alpha=math.acos(cosAlpha)
local lateralOut=Vector3.new(-dirUnit.Z * side,1.35,dirUnit.X * side).Unit
local planeBasis=CFrame.lookAt(hipPos,hipPos + dirUnit,lateralOut)
local femurDir=(planeBasis * CFrame.Angles(alpha + twitchAngle,side * 0.12,0)).LookVector
local kneePos=hipPos + femurDir * femurLen
local femurMid=hipPos:Lerp(kneePos,0.5)
local femurCF=CFrame.lookAt(femurMid,kneePos)* CFrame.Angles(0,math.rad(90),0)
local tibiaMid=kneePos:Lerp(footPos,0.5)
local tibiaCF=CFrame.lookAt(tibiaMid,footPos)* CFrame.Angles(0,math.rad(90),0)
local clawCF=CFrame.lookAt(footPos + Vector3.new(0,0.9,0),footPos)
* CFrame.Angles(math.rad(-25),0,0)
return femurCF,tibiaCF,clawCF
end
