local hubRot=-pTime * 2.8 * speedMult
local seatRot=pTime * 4.2 * speedMult
return mainTilt,mainRot,hubRot,seatRot
end
local function getTagadaState(pTime,totalDuration)
local p=math.clamp(pTime / totalDuration,0,1)
local speedMult=(p < 0.15 and(p / 0.15))or((p > 0.85 and(1 -(p - 0.85)/ 0.15))or 1.0)
local spinAng=pTime * 1.5 * speedMult
local tiltAng=math.rad(13)
local bouncePneumatic=math.abs(math.sin(pTime * 3.8))^ 3 * 5.0 * speedMult
return spinAng,tiltAng,bouncePneumatic
end
local function getStarFlyerState(pTime,totalDuration)
local p=math.clamp(pTime / totalDuration,0,1)
local heightMax=210
local yPos=0
local spinSpeed=0
if p < 0.35 then
local tau=p / 0.35
