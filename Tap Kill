pcall(function()if saveConfig then saveConfig()end end)
end
return false
end
curPiece=newPiece
return true
end
local function clearFullLines()
local clearedCount=0
local r=ROWS
while r >=1 do
local isFull=true
for c=1,COLS do
if board[r][c]==nil then
isFull=false
break
end
end
if isFull then
clearedCount=clearedCount + 1
for shiftR=r,2,-1 do
board[shiftR]=board[shiftR - 1]
end
board[1]={}
for c=1,COLS do board[1][c]=nil end
else
r=r - 1
end
end
if clearedCount > 0 then
playSfx(6895079853,0.45)
local lineScores={100,300,500,800}
local pts=(lineScores[clearedCount]or(clearedCount * 200))* level
score=score + pts
lines=lines + clearedCount
level=math.floor(lines / 10)+ 1
if clearedCount >=4 then
showIslandToast("TETRIS! +".. tostring(pts),Color3.fromRGB(255,215,0),2.0)
end
if score >(phoneConfig.tetrisHighScore or 0)then
phoneConfig.tetrisHighScore=score
bestValLbl.Text=tostring(score)
pcall(function()if saveConfig then saveConfig()end end)
end
end
end
local function lockPiece()
if not curPiece then return end
local def=TETRO_DEFS[curPiece.type]
local mat=def.rot[curPiece.rot]
local sz=#mat
for r=1,sz do
for c=1,sz do
if mat[r][c]==1 then
local bx=curPiece.x + c - 1
local by=curPiece.y + r - 1
if bx >=1 and bx <=COLS and by >=1 and by <=ROWS then
board[by][bx]=def.color
end
end
end
end
clearFullLines()
spawnPiece()
render()
end
local function movePiece(dx,dy)
if not curPiece or isGameOver or isPaused then return false end
if canPlace(curPiece.type,curPiece.rot,curPiece.x + dx,curPiece.y + dy)then
curPiece.x=curPiece.x + dx
curPiece.y=curPiece.y + dy
render()
return true
end
return false
end
local function rotatePiece()
if not curPiece or isGameOver or isPaused then return end
local newRot=(curPiece.rot % 4)+ 1
local offsets={0,-1,1,-2,2}
for _,off in ipairs(offsets)do
if canPlace(curPiece.type,newRot,curPiece.x + off,curPiece.y)then
curPiece.rot=newRot
curPiece.x=curPiece.x + off
render()
return
end
end
end
local function softDrop()
if not movePiece(0,1)then
lockPiece()
end
end
local function hardDrop()
if not curPiece or isGameOver or isPaused then return end
while movePiece(0,1)do end
lockPiece()
end
