rayParams.FilterType=Enum.RaycastFilterType.Exclude
local function getGroundPosition(worldXZ: Vector3,referenceY: number): Vector3
local origin=V3(worldXZ.X,referenceY + 12,worldXZ.Z)
local result=Workspace:Raycast(origin,V3(0,-35,0),rayParams)
if result then
return result.Position
end
return V3(worldXZ.X,referenceY - 3.0,worldXZ.Z)
end
