local function solveTwoBone(rootPos,targetPos,l1,l2,bendHint)
local d=targetPos - rootPos
local dist=d.Magnitude
if dist < 1e-4 then
return rootPos + unitV3(bendHint,UNIT_F)* l1,targetPos
end
local dir=d / dist
local maxR=math.max(1e-3,l1 + l2 - 0.04)
local minR=math.abs(l1 - l2)+ 0.04
local eff=clamp(dist,minR,maxR)
local cosA=clamp((l1 * l1 + eff * eff - l2 * l2)/(2.0 * l1 * eff),-1.0,1.0)
local sinA=math.sqrt(math.max(0.0,1.0 - cosA * cosA))
local bend=bendHint - dir * bendHint:Dot(dir)
if bend.Magnitude < 1e-4 then
bend=Vector3.new(0,0,-1)
else
bend=bend.Unit
end
local elbow=rootPos +(dir * cosA + bend * sinA)* l1
return elbow,targetPos
end
