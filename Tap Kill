local function tyshGetBlackRainbowColor(nowTime,propIdx,totalPropsCount)
local total=(totalPropsCount and totalPropsCount > 0)and totalPropsCount or 1
local offset=(propIdx and propIdx > 0)and((propIdx - 1)/ total)or 0
local cycle=((nowTime * 0.4)+ offset)% 1
local phase=cycle * 4
local step=math.floor(phase)
local frac=phase - step
if step==0 then
return Color3.fromRGB(
math.floor(130 +(90 - 130)* frac),
0,
math.floor(70 * frac)
)
elseif step==1 then
return Color3.fromRGB(
math.floor(90 +(12 - 90)* frac),
math.floor(12 * frac),
math.floor(70 +(15 - 70)* frac)
)
elseif step==2 then
return Color3.fromRGB(
math.floor(12 +(75 - 12)* frac),
math.floor(12 *(1 - frac)),
math.floor(15 +(110 - 15)* frac)
)
else
return Color3.fromRGB(
math.floor(75 +(130 - 75)* frac),
0,
math.floor(110 *(1 - frac))
)
end
end
