* cfDeg(0.4 * sig.maneWave3,0.7 * sig.maneWave3,sig.maneWave3)
* cfFromXY(ZERO_V3,Vector3.new(0.22,0.96,0.16),Vector3.new(-0.95,0.24,-0.18))
