local function evalSignals(state,actT,now,dt)
local rBreath,rTwist,rLash,rDive,rRoar=0,0,0,0,0
if state.activeMove=="BlastBreath"then rBreath=math.sin(actT * math.pi)
elseif state.activeMove=="DragonTwister"then rTwist=actT
elseif state.activeMove=="TailLash"then rLash=math.sin(actT * math.pi)
elseif state.activeMove=="AscentDive"then rDive=math.sin(actT * math.pi)
elseif state.activeMove=="KaidoRoar"then rRoar=math.sin(actT * math.pi)end
local a=state.anim
a.breath=expBlend(a.breath or 0,rBreath,14,dt)
a.twister=expBlend(a.twister or 0,rTwist,16,dt)
a.lash=expBlend(a.lash or 0,rLash,16,dt)
a.dive=expBlend(a.dive or 0,rDive,12,dt)
a.roar=expBlend(a.roar or 0,rRoar,12,dt)
state.stridePhase=state.stridePhase + dt *(2.6 + state.moveSpeed * 0.14)
local bank=clamp(-(state.yawVel or 0)* 14,-36,36)
a.bank=expBlend(a.bank or 0,bank,8,dt)
return a
end
local function computePathPoints(state,a,now,flightMode,hrp)
local pts={}
local rootCF=CFrame.new(state.rootPos)* CFrame.Angles(0,state.rootYaw,0)
local phi=state.stridePhase
local turnLag=clamp(-(state.yawVel or 0)* 0.18,-0.45,0.45)
local sIdx=state.surroundIdx or 1
if flightMode then
local arcRoll=360 * a.twister
local baseCF=rootCF * cfDeg(18 * a.roar - 32 * a.dive,arcRoll,a.bank)
for i=0,10 do
local lag=i * 0.52
local wX=math.sin(phi - lag)*(1.2 + i * 0.18)+(turnLag * i * i * 0.14)+(a.lash * math.sin(i * 0.45)* 6.5)
local wY=math.cos(phi * 0.85 - lag)*(0.9 + 0.14 * i)+(i * 0.25 * a.dive)
pts[i]=(baseCF * CFrame.new(wX,wY,i * 2.25 - 7.5)).Position
end
else
local center=hrp and hrp.Position or state.rootPos
local orb=now * 1.15
for i=0,10 do
local t=i / 10
if sIdx==1 then
local ang=orb - t * 4.4
local r=6.5 + 1.5 * math.sin(now * 1.8 + t * 2)
pts[i]=center + Vector3.new(math.cos(ang)* r,7.2 - t * 7.8 + 0.8 * math.sin(now * 2.2 - t * 3),math.sin(ang)* r)
elseif sIdx==2 then
local ang=orb * 1.8 - t * 6.2
local r=4.0 + t * 6.8
pts[i]=center + Vector3.new(math.cos(ang)* r,9.5 - t * 9.5,math.sin(ang)* r)
elseif sIdx==3 then
local ang=state.rootYaw +(t - 0.5)* 3.6
pts[i]=center + Vector3.new(math.sin(ang)* 5.8,8.2 - t * 5.4 + math.sin(now * 2 - t * 2)* 0.5,math.cos(ang)* 5.8)
else
local ang=orb * 0.9 - t * 3.8
pts[i]=center + Vector3.new(math.cos(ang)* 8.0,9.2 + math.sin(ang * 2)* 1.8,math.sin(ang)* 8.0)
end
end
end
return pts
end
