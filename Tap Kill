function SavenowEngine.ConvertAndDownload(videoIdOrUrl,formatType,onProgress)
formatType=formatType or"mp3"
local fullYtUrl=string.match(videoIdOrUrl,"^https?://")and videoIdOrUrl or("https://www.youtube.com/watch?v=".. videoIdOrUrl)
local token=SavenowEngine.GetBearerToken()
if not token then
return nil,"Unable to authorize download"
end
if onProgress then pcall(onProgress,5,"Initializing stream...")end
local initUrl=string.format("%s/api/v2/download?format=%s&url=%s&apikey=%s",
SavenowEngine.BaseUrl,
formatType,
HttpService:UrlEncode(fullYtUrl),
SavenowEngine.ApiKey
)
local initRes=httpRequest({Url=initUrl,Method="GET",Headers=snGetHeaders(token)})
local initData=decodeResponse(initRes)
if not initData or not initData.progress_url then
return nil,"Failed to initialize stream converter"
end
local progUrl=initData.progress_url
local finalResult=nil
local startTime=os.clock()
local displayPct=8
local stuckDone=0
while(os.clock()- startTime)< 55.0 do
task.wait(1.5)
local elapsed=os.clock()- startTime
if displayPct < 88 then
displayPct=math.min(88,math.floor(8 +(elapsed / 20.0)* 80))
end
local pRes=httpRequest({Url=progUrl,Method="GET",Headers=snGetHeaders(token)})
local pData=decodeResponse(pRes)
if pData then
if pData.progress==1000 and type(pData.download_url)=="string"then
finalResult=pData
break
else
if pData.progress==1000 then
stuckDone=stuckDone + 1
if stuckDone >=2 then
finalResult=pData
break
end
end
local sMsg="Encoding studio audio..."
if displayPct < 30 then sMsg="Fetching YouTube master..."
elseif displayPct < 60 then sMsg="Encoding 320kbps MP3..."
else sMsg="Finalizing studio stream..."end
if onProgress then pcall(onProgress,displayPct,sMsg)end
end
end
end
if not finalResult then
return nil,"Conversion timed out"
end
local downloadCandidates={}
if type(finalResult.download_url)=="string"and #finalResult.download_url > 0 then
table.insert(downloadCandidates,finalResult.download_url)
end
if type(finalResult.alternative_download_urls)=="table"then
for _,altObj in ipairs(finalResult.alternative_download_urls)do
if #downloadCandidates >=4 then break end
if type(altObj)=="table"and type(altObj.url)=="string"and altObj.url ~=finalResult.download_url then
table.insert(downloadCandidates,altObj.url)
elseif type(altObj)=="string"and altObj ~=finalResult.download_url then
table.insert(downloadCandidates,altObj)
end
end
end
if #downloadCandidates==0 then
return nil,"No download links available"
end
if onProgress then pcall(onProgress,92,"Downloading audio data...")end
local dlHeaders={
["Accept"]="*/*",
["Accept-Language"]="fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7",
["User-Agent"]="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
["Referer"]="https://en.loader.to/"
}
for i=1,#downloadCandidates do
local link=downloadCandidates[i]
if link and type(link)=="string"then
if game and game.HttpGet then
local okHg,hgData=pcall(game.HttpGet,game,link)
if okHg and hgData and #hgData > 20000 then
if onProgress then pcall(onProgress,100,"Ready!")end
return hgData,nil
end
end
local audioBytes=httpRequest({Url=link,Method="GET",Headers=dlHeaders})
local raw=audioBytes and(audioBytes.Body or audioBytes.body)
if raw and #raw > 20000 then
if onProgress then pcall(onProgress,100,"Ready!")end
return raw,nil
end
end
end
return nil,"Failed to download converted audio from all sources"
end
end
