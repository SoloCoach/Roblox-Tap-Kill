local spinRot=bodySpin - bodySpin.Position
local armSpecs={
{
s=1,suf="R",
idleWr=Vector3.new(2.25,3.92,-1.85):Lerp(Vector3.new(2.45,3.88,-1.25),h),
idlePole=Vector3.new(1.55,0.55,1.15):Lerp(Vector3.new(1.75,0.35,1.35),h),
idleFwd=unitV3(Vector3.new(0.08,-0.72,-0.69):Lerp(Vector3.new(-0.24,-0.68,-0.69),h)),
idleUp=unitV3(Vector3.new(-0.16,0.68,-0.72):Lerp(Vector3.new(0.06,0.68,-0.73),h)),
},
{
s=-1,suf="L",
idleWr=Vector3.new(-2.25,3.92,-1.85):Lerp(Vector3.new(-1.65,4.10,-2.25),h),
idlePole=Vector3.new(-1.55,0.55,1.15):Lerp(Vector3.new(-1.75,0.65,0.95),h),
idleFwd=unitV3(Vector3.new(-0.08,-0.72,-0.69):Lerp(Vector3.new(0.16,-0.72,-0.67),h)),
idleUp=unitV3(Vector3.new(0.16,0.68,-0.72):Lerp(Vector3.new(-0.18,0.66,-0.73),h)),
},
}
for _,arm in ipairs(armSpecs)do
local s,suf=arm.s,arm.suf
local sh=chestCF * Vector3.new(s * 1.18,0.98,-0.22)
local baseWr=bodySpin *(arm.idleWr + Vector3.new(0,0.08 * sig.breath,0))
local basePole=spinRot * arm.idlePole
local baseFwd=spinRot * arm.idleFwd
local baseUp=spinRot * arm.idleUp
local am=clamp(sig["armMove".. suf]or 0,0,1)
local movWr=bodySpin * Vector3.new(sig["armTar".. suf .."X"],sig["armTar".. suf .."Y"],sig["armTar".. suf .."Z"])
local movPole=spinRot * Vector3.new(sig["armPole".. suf .."X"],sig["armPole".. suf .."Y"],sig["armPole".. suf .."Z"])
local movFwd=spinRot * unitV3(Vector3.new(sig["handFwd".. suf .."X"],sig["handFwd".. suf .."Y"],sig["handFwd".. suf .."Z"]))
local movUp=spinRot * unitV3(Vector3.new(sig["handUp".. suf .."X"],sig["handUp".. suf .."Y"],sig["handUp".. suf .."Z"]))
local wrist=baseWr:Lerp(movWr,am)
local elbPole=basePole:Lerp(movPole,am)
local handFwd=unitV3(baseFwd:Lerp(movFwd,am))
local handUp=unitV3(baseUp:Lerp(movUp,am))
local elb,wristC=solveTwoBoneClamped(sh,wrist,2.75,2.85,elbPole,0.22)
poses["UpperArm".. suf]=aimCenterY(sh,elb,chestCF.LookVector,0)
local faDir=unitV3(wristC - elb,UNIT_F)
poses["Forearm".. suf]=aimCenterY(elb,wristC - faDir * 0.15,chestCF.LookVector,0)
local clawSubs={}
placeThreeClaws(clawSubs,wristC,handFwd,handUp,s,"Claw",12.5,1.18,0.25)
for _,dn in ipairs({"Out","Mid","In"})do
poses["Claw".. dn .. suf]=clawSubs["Claw".. dn]
end
end
local legDy={dyR or 0,dyL or 0}
local legSpecs={
{
s=1,suf="R",dy=legDy[1],
idleHock=Vector3.new(1.70,2.12,1.95):Lerp(Vector3.new(1.75,2.10,0.65),h),
idlePaw=Vector3.new(1.60,0.52,0.55):Lerp(Vector3.new(1.38,0.52,-0.55),h),
idlePole=Vector3.new(0.65,0.50,-1.40):Lerp(Vector3.new(0.85,0.45,-1.45),h),
idleFwd=unitV3(Vector3.new(0.18,0,-0.98):Lerp(Vector3.new(0.32,0,-0.95),h)),
},
{
s=-1,suf="L",dy=legDy[2],
idleHock=Vector3.new(-1.70,2.12,1.95):Lerp(Vector3.new(-3.05,2.15,2.75),h),
idlePaw=Vector3.new(-1.60,0.52,0.55):Lerp(Vector3.new(-3.18,0.52,1.35),h),
idlePole=Vector3.new(-0.65,0.50,-1.40):Lerp(Vector3.new(-0.95,0.45,-1.25),h),
idleFwd=unitV3(Vector3.new(-0.18,0,-0.98):Lerp(Vector3.new(-0.24,0,-0.97),h)),
},
}
for _,lg in ipairs(legSpecs)do
local s,suf=lg.s,lg.suf
local hip=pelvisCF * Vector3.new(s * 0.92,-0.05,0.15)
local dyOff=Vector3.new(0,lg.dy *(1 - tuck),0)
local mPaw=Vector3.new(sig["paw".. suf .."X"],sig["paw".. suf .."Y"],sig["paw".. suf .."Z"])+ dyOff
local mFlatFwd=unitV3(Vector3.new(s * 0.14,0,-0.99))
local crouchComp=clamp(-sig.crouchY,0,1.1)
local mHock=mPaw + Vector3.new(s * 0.10,1.56 - 0.16 * crouchComp,0)- mFlatFwd * 1.38
local mPole=Vector3.new(s * 0.72,0.50,-1.42)
local iPaw=lg.idlePaw + dyOff
local iHock=lg.idleHock + dyOff
local pawGround=iPaw:Lerp(mPaw,mw)
local hockGround=iHock:Lerp(mHock,mw)
local poleGround=lg.idlePole:Lerp(mPole,mw)
local flatFwd=unitV3(lg.idleFwd:Lerp(mFlatFwd,mw))
local pawFinal,hockTarget,poleFinal
if tuck > 1e-4 then
local tuckPaw=pelvisCF * Vector3.new(s * 1.45,-2.55,0.45)
local tuckHock=pelvisCF * Vector3.new(s * 1.65,-0.95,1.85)
local tuckPole=spinRot * Vector3.new(s * 0.75,0.40,-1.55)
pawFinal=pawGround:Lerp(tuckPaw,tuck)
hockTarget=hockGround:Lerp(tuckHock,tuck)
poleFinal=poleGround:Lerp(tuckPole,tuck)
else
pawFinal=pawGround
hockTarget=hockGround
poleFinal=poleGround
end
local knee,hockC=solveTwoBoneClamped(hip,hockTarget,2.35,2.80,poleFinal,0.22)
local thDir=unitV3(knee - hip,UNIT_Y)
local shDir=unitV3(hockC - knee,UNIT_Y)
poses["Thigh".. suf]=aimConeTip(hip,knee + thDir * 0.40,2.0,UNIT_Y)
poses["Shin".. suf]=aimCenterY(knee - shDir * 0.06,hockC,UNIT_F,0)
local fpDeg=sig["footPitch".. suf]* mw *(1 - tuck)- 24.0 * tuck
local pr=math.rad(fpDeg)
local footFwd=unitV3(flatFwd * math.cos(pr)+ UNIT_Y * math.sin(pr))
local footUp=unitV3(-flatFwd * math.sin(pr)+ UNIT_Y * math.cos(pr))
local tarEnd=pawFinal + footFwd * 0.22 + footUp * 0.22
poses["Tarsus".. suf]=aimCenterY(hockC,tarEnd,footUp,0)
local toeSubs={}
placeThreeClaws(toeSubs,pawFinal + footFwd * 0.22,footFwd,footUp,s,"Toe",14.0,0.68,0.22)
for _,dn in ipairs({"Out","Mid","In"})do
poses["Toe".. dn .. suf]=toeSubs["Toe".. dn]
end
end
return poses
end
