function MusicStreamEngine:DownloadAndAssembleHlsMp3(m3u8Url,onProgressCallback)
local playlistText,err=MusicNetwork.Request(m3u8Url)
if not playlistText then
return nil,"Failed to fetch HLS M3U8 playlist: ".. tostring(err)
end
local segmentUrls={}
for line in string.gmatch(playlistText,"[^\r\n]+")do
local trimmed=string.match(line,"^%s*(.-)%s*$")or""
if trimmed ~=""and string.sub(trimmed,1,1)~="#"then
if string.match(trimmed,"^https?://")then
table.insert(segmentUrls,trimmed)
end
end
end
local totalSegments=#segmentUrls
if totalSegments==0 then
return nil,"HLS playlist contained 0 valid MP3 segment URLs"
end
local segmentsData={}
local batchSize=MUSIC_CONFIG.HlsParallelBatchSize
for batchStart=1,totalSegments,batchSize do
local batchEnd=math.min(totalSegments,batchStart + batchSize - 1)
local remainingInBatch=(batchEnd - batchStart + 1)
for idx=batchStart,batchEnd do
task.spawn(function()
local segBytes=MusicNetwork.Request(segmentUrls[idx])
if not segBytes or #segBytes==0 then
segBytes=MusicNetwork.Request(segmentUrls[idx])
end
segmentsData[idx]=segBytes or""
remainingInBatch=remainingInBatch - 1
end)
end
local waitStart=os.clock()
while remainingInBatch > 0 and(os.clock()- waitStart)< 15.0 do
task.wait(0.03)
end
if onProgressCallback then
local pct=math.floor((batchEnd / totalSegments)* 100)
pcall(onProgressCallback,pct,batchEnd,totalSegments)
end
end
local orderedChunks={}
for i=1,totalSegments do
if segmentsData[i]and #segmentsData[i]> 0 then
table.insert(orderedChunks,segmentsData[i])
end
end
local fullMp3Binary=table.concat(orderedChunks,"")
return fullMp3Binary,nil
end
