local moveStep=diveSpeed * stepDt
if currentDist <=moveStep or curBossPos.Y <=(impactGroundY + CONFIG.GroundImpactOffset + 0.5)or(tick()- diveStartTime > 2.2)then
diving=false
BossState.PrimaryPart.CFrame=CFrame.lookAt(targetImpactPoint,targetImpactPoint + BossState.PrimaryPart.CFrame.LookVector)
playSound(CONFIG.Sounds.Explosion,1.35,false,BossState.PrimaryPart)
