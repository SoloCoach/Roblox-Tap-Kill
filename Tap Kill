local s=(touch1 and touch1.Size)or Vector3.new(15,15,1)
local pivotOffset=(touch1 and list[1])and touch1.CFrame:ToObjectSpace(list[1]:GetPivot())or CFrame.new()
local desiredTouchCFs={}
if s.Z < s.Y and s.Z < s.X then
local side=math.min(s.X,s.Y)
local half=(side / 2)-(s.Z / 2)
solidBoxHalfExtent=half - 0.5
local center=CFrame.new(targetPos.X,targetPos.Y + half - 2.8,targetPos.Z)
solidBoxCenterPos=center.Position
desiredTouchCFs={
center * CFrame.new(0,-half,0)* CFrame.Angles(math.rad(90),0,0),
center * CFrame.new(0,half,0)* CFrame.Angles(math.rad(90),0,0),
center * CFrame.new(0,0,-half),
center * CFrame.new(0,0,half),
center * CFrame.new(-half,0,0)* CFrame.Angles(0,math.rad(90),0),
center * CFrame.new(half,0,0)* CFrame.Angles(0,math.rad(90),0),
}
else
local W,T,L=s.X,s.Y,s.Z
if W > L then W,L=L,W end
local half=(L / 2)-(T / 2)
solidBoxHalfExtent=half - 0.5
local center=CFrame.new(targetPos.X,targetPos.Y + half - 2.8,targetPos.Z)
solidBoxCenterPos=center.Position
local faceCenters={
center * CFrame.new(0,-half,0),
center * CFrame.new(0,half,0),
center * CFrame.new(0,0,-half)* CFrame.Angles(math.rad(90),0,0),
center * CFrame.new(0,0,half)* CFrame.Angles(math.rad(90),0,0),
center * CFrame.new(-half,0,0)* CFrame.Angles(0,math.rad(90),0)* CFrame.Angles(math.rad(90),0,0),
center * CFrame.new(half,0,0)* CFrame.Angles(0,math.rad(90),0)* CFrame.Angles(math.rad(90),0,0),
}
for _,fc in ipairs(faceCenters)do
table.insert(desiredTouchCFs,fc * CFrame.new(-W / 2,0,0))
table.insert(desiredTouchCFs,fc * CFrame.new(W / 2,0,0))
end
end
local useCount=math.min(#list,#desiredTouchCFs)
local doneCount=0
