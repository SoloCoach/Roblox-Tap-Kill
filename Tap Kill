local function pulseCurve(t,tIn,tHold,tOut)
if t <=0 or t >=1 then return 0 end
if t < tIn then return smoothstep(clamp(t / math.max(tIn,0.001),0,1))end
if t <=tHold then return 1 end
return 1 - smoothstep(clamp((t - tHold)/ math.max(tOut - tHold,0.001),0,1))
end
local function bellWindow(t,t0,peak,t1)
if t <=t0 or t >=t1 then return 0 end
if t < peak then return smoothstep(clamp((t - t0)/ math.max(peak - t0,0.001),0,1))end
return 1 - smoothstep(clamp((t - peak)/ math.max(t1 - peak,0.001),0,1))
end
