function TyShDragonSystem.Init()
updateMenuResponsiveScale()
end
function TyShDragonSystem.Spawn(nameOrIndex,autoMount)
if autoMount==nil then
autoMount=true
end
local idx=2
if type(nameOrIndex)=="number"then
idx=math.clamp(nameOrIndex,1,#DRAGONS)
elseif type(nameOrIndex)=="string"then
for i,d in ipairs(DRAGONS)do
if d.Id:lower()==nameOrIndex:lower()or d.DisplayName:lower():find(nameOrIndex:lower())then
idx=i
break
end
end
end
selectedIndex=idx
TyShDragonSystem.State.SelectedIndex=idx
spawnDragon(idx,autoMount)
end
function TyShDragonSystem.Despawn()
cleanupDragon()
end
function TyShDragonSystem.ToggleMount()
toggleMount(nil,true)
end
function TyShDragonSystem.Mount()
if not isRiding then toggleMount(true,true)end
end
function TyShDragonSystem.Dismount()
if isRiding then toggleMount(false,true)end
end
function TyShDragonSystem.ShootFireball()
shootFireball()
end
function TyShDragonSystem.StartFlame()
startFireBreath()
end
function TyShDragonSystem.StopFlame()
stopFireBreath()
end
function TyShDragonSystem.Roar()
triggerRoarAction()
end
function TyShDragonSystem.SetScale(scaleValue)
if type(scaleValue)=="number"then
currentScale=math.clamp(scaleValue,0.3,2.5)
TyShDragonSystem.State.CurrentScale=currentScale
if currentDragon then
