dangerRing.Name="TySh_DangerRing"
dangerRing.Shape=Enum.PartType.Cylinder
dangerRing.Size=Vector3.new(0.4,44,44)
dangerRing.Color=(BossState.IsPhase2 or BossState.IsPhase3)and Color3.fromRGB(255,45,45)or Color3.fromRGB(45,235,110)
dangerRing.Material=Enum.Material.Neon
dangerRing.Transparency=0.55
dangerRing.CanCollide=false
dangerRing.CanTouch=false
dangerRing.CanQuery=false
dangerRing.Anchored=true
dangerRing.CFrame=CFrame.new(targetImpactPoint)* CFrame.Angles(0,0,math.rad(90))
dangerRing.Parent=Workspace
telegraphAttackBuildup("DiveBomb",1.8)
