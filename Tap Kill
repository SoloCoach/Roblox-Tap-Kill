local combinedCand=candTitleLower .." ".. candTagsLower
for _,badWord in ipairs(MUSIC_CONFIG.DisqualifyingKeywords)do
if not string.find(refLower,badWord,1,true)then
if string.find(combinedCand,badWord,1,true)then
return true
end
end
end
local alteredSpeedWords={"slowed","sped up","speed up","chopped"}
for _,sWord in ipairs(alteredSpeedWords)do
if not string.find(refLower,sWord,1,true)then
if string.find(candTitleLower,sWord,1,true)then
return true
end
end
end
return false
end
function MusicStreamEngine:ScoreCandidateAgainstMaster(cand,catalogTrack,normArtist,titleTokens)
if self:IsCandidateAmateurOrCover(cand,catalogTrack.Title)then
return -99999
end
local targetDuration=tonumber(catalogTrack.DurationSeconds)or 180
local durationDiff=math.abs((cand.DurationSeconds or 0)- targetDuration)
if durationDiff > 22 then
return -99999
end
local score=0
local candNormTitle=MusicNetwork.NormalizeText(cand.Title)
local candNormArtist=MusicNetwork.NormalizeText(cand.Artist .." "..(cand.UploaderName or""))
local candCombined=candNormTitle .." ".. candNormArtist
if catalogTrack.Isrc and cand.Isrc and cand.Isrc==catalogTrack.Isrc then
score=score + 600
end
local matchedTokens=0
for _,token in ipairs(titleTokens)do
if string.find(candCombined,token,1,true)then
matchedTokens=matchedTokens + 1
end
end
local coverage=(#titleTokens > 0)and(matchedTokens / #titleTokens)or 1
if coverage < 0.5 then
return -99999
end
score=score + math.floor(coverage * 90)
local hasArtistName=string.find(candCombined,normArtist,1,true)~=nil
if hasArtistName then
score=score + 75
elseif coverage >=0.85 and durationDiff <=4 then
score=score + 45
else
score=score - 90
end
if durationDiff <=2 then
score=score + 100
elseif durationDiff <=5 then
score=score + 75
elseif durationDiff <=10 then
score=score + 35
else
score=score - 15
end
local plays=tonumber(cand.PlaybackCount)or 0
if plays >=500000 then
score=score + 130
elseif plays >=100000 then
score=score + 100
elseif plays >=20000 then
score=score + 75
elseif plays >=3000 then
score=score + 50
elseif plays >=500 then
score=score + 20
elseif plays < 150 and not cand.IsVerified then
if durationDiff <=2 and hasArtistName then
score=score + 5
else
score=score - 120
end
end
if cand.IsVerified then
score=score + 80
end
return score
end
function MusicStreamEngine:FindStudioStreamForCatalogTrack(catalogTrack,sharedCandidatePool)
local rawArtist=catalogTrack.Artist
local rawTitle=MusicNetwork.StripParentheses(catalogTrack.Title)
local normArtist=MusicNetwork.NormalizeText(rawArtist)
local normTitle=MusicNetwork.NormalizeText(rawTitle)
local titleTokens={}
for token in string.gmatch(normTitle,"%S+")do
if #token >=2 then
table.insert(titleTokens,token)
end
end
local bestCandidate=nil
local bestScore=-99999
local function evaluateList(list)
for _,cand in ipairs(list)do
local s=self:ScoreCandidateAgainstMaster(cand,catalogTrack,normArtist,titleTokens)
if s > bestScore then
bestScore=s
bestCandidate=cand
end
end
end
if sharedCandidatePool and #sharedCandidatePool > 0 then
evaluateList(sharedCandidatePool)
end
if bestScore < 130 then
local dedicatedSc=self:QuerySoundCloudCandidates(string.format("%s %s",rawArtist,rawTitle),25)
evaluateList(dedicatedSc)
end
if bestScore < 95 then
local altSc=self:QuerySoundCloudCandidates(string.format("%s %s audio",normArtist,normTitle),20)
evaluateList(altSc)
end
if bestScore < 85 then
local auList=self:QueryAudiusCandidates(string.format("%s %s",rawArtist,rawTitle),6)
evaluateList(auList)
end
if bestCandidate and bestScore >=75 then
return bestCandidate,bestScore
end
return nil,bestScore
end
