end
end
table.insert(AppRegistry.order,appDef.id)
if refreshAllInstalledApps then refreshAllInstalledApps()end
end
function AppRegistry.get(selfOrId,maybeId)
local id=(type(selfOrId)=="table"and maybeId)and maybeId or selfOrId
return AppRegistry.apps[id]
end
function AppRegistry.getAll()
local list={}
for _,id in ipairs(AppRegistry.order)do
table.insert(list,AppRegistry.apps[id])
end
