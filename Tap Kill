elseif state.activeMove=="BurningTails"then rTails=math.sin(actT * math.pi)
elseif state.activeMove=="WildAssault"then rAssault=math.sin(actT * math.pi)
elseif state.activeMove=="FoxDisruption"then rDisrupt=actT
elseif state.activeMove=="TransformRoar"then rRoar=math.sin(actT * math.pi)end
local a=state.anim
a.blast=expBlend(a.blast or 0,rBlast,18,dt)
a.tails=expBlend(a.tails or 0,rTails,16,dt)
a.assault=expBlend(a.assault or 0,rAssault,20,dt)
a.disrupt=expBlend(a.disrupt or 0,rDisrupt,16,dt)
a.roar=expBlend(a.roar or 0,rRoar,12,dt)
local moveBlend=clamp(state.moveSpeed / 12.0,0,1)
local gallopW=clamp((state.moveSpeed - 24.0)/ 24.0,0,1)
if state.moveSpeed > 0.5 then
state.stridePhase=state.stridePhase + dt *(7.5 + state.moveSpeed * 0.14)
end
local roarLift=a.roar * 1.0 + a.blast * 0.35 + a.assault * 0.25 + a.disrupt * 0.50
local fireball=a.blast * 1.15
local jawOpen=clamp(0.05 + 0.95 * a.roar + 0.95 * a.blast + 0.85 * a.assault + 0.60 * a.disrupt + 0.45 * a.tails,0.05,1.0)
local tailWhip=math.sin(actT * math.pi * 4.0)* 32.0 * a.tails
local spinDeg=360.0 * a.tails + 720.0 * a.disrupt
local stride=state.stridePhase
local bounce=moveBlend *(0.38 * math.abs(math.sin(stride)))+(1 - moveBlend)*(0.10 * math.sin(now * 2.4))
local pitchBody=moveBlend *(6.0 * math.cos(stride))- 8.0 * a.assault + 12.0 * a.roar - 4.0 * a.blast
