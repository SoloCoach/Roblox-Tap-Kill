end
function AppRegistry.isInstalled(selfOrId,maybeId)
local id=(type(selfOrId)=="table"and maybeId)and maybeId or selfOrId
local app=AppRegistry.apps[id]
if not app then return false end
if app.isPreinstalled then return true end
if phoneConfig.installedApps then
for _,instId in ipairs(phoneConfig.installedApps)do
if instId==id then return true end
end
end
return false
end
function AppRegistry.install(selfOrId,maybeId,callback)
local id=(type(selfOrId)=="table"and maybeId)and maybeId or selfOrId
local cb=(type(selfOrId)=="table"and callback)and callback or(type(maybeId)=="function"and maybeId or nil)
local app=AppRegistry.apps[id]
if not app then return false end
if not AppRegistry.isInstalled(id)then
phoneConfig.installedApps=phoneConfig.installedApps or{"AppStore"}
table.insert(phoneConfig.installedApps,id)
saveConfig()
end
if app.onInstall then pcall(app.onInstall)end
if refreshAllInstalledApps then refreshAllInstalledApps()end
if renderSpringGrid then renderSpringGrid()end
if cb and type(cb)=="function"then cb(true)end
return true
end
function AppRegistry.uninstall(selfOrId,maybeId,callback)
local id=(type(selfOrId)=="table"and maybeId)and maybeId or selfOrId
local cb=(type(selfOrId)=="table"and callback)and callback or(type(maybeId)=="function"and maybeId or nil)
local app=AppRegistry.apps[id]
if not app or app.isPreinstalled then return false end
if phoneConfig.installedApps then
for i=#phoneConfig.installedApps,1,-1 do
if phoneConfig.installedApps[i]==id then
table.remove(phoneConfig.installedApps,i)
end
end
saveConfig()
end
if app.onUninstall then pcall(app.onUninstall)end
if refreshAllInstalledApps then refreshAllInstalledApps()end
