for _,item in ipairs(data.items)do
local vidId=string.match(tostring(item.url or""),"v=([%w%-_]+)")
local dur=tonumber(item.duration)or 180
if vidId and item.title and dur > 0 then
table.insert(videos,{
VideoId=vidId,
Title=tostring(item.title),
Author=tostring(item.uploaderName or"YouTube Creator"),
Views=tonumber(item.views)or 50000,
DurationSeconds=dur,
DurationFormatted=Network.FormatTime(dur),
ThumbnailUrl=string.format("https://i.ytimg.com/vi/%s/hqdefault.jpg",vidId)
})
if #videos >=maxResults then return videos end
end
end
end
end
for _,host in ipairs(CONFIG.InvidiousInstances)do
local data=Network.GetJson(string.format("%s/api/v1/search?q=%s&type=video",host,encoded))
if data and #data > 0 then
for _,item in ipairs(data)do
if item.videoId and item.title then
local dur=tonumber(item.lengthSeconds)or 180
table.insert(videos,{
VideoId=tostring(item.videoId),
Title=tostring(item.title),
Author=tostring(item.author or"YouTube Creator"),
Views=tonumber(item.viewCount)or 25000,
