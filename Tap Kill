local function hookTextChannel(ch)
if ch:IsA("TextChannel")then
local conn=ch.MessageReceived:Connect(function(msg)
if not msg then return end
local textContent=msg.Text or msg.RawText
if not textContent or textContent==""then return end
local sender=nil
if msg.TextSource then
sender=Players:GetPlayerByUserId(msg.TextSource.UserId)
end
if sender then
task.spawn(function()
processIncomingChat(sender,textContent)
end)
end
end)
table.insert(_G.BTR_FakeAdminConns,conn)
end
end
local channelsFolder=TCS:FindFirstChild("TextChannels")
if channelsFolder then
for _,ch in ipairs(channelsFolder:GetChildren())do
hookTextChannel(ch)
end
local chAddConn=channelsFolder.ChildAdded:Connect(hookTextChannel)
table.insert(_G.BTR_FakeAdminConns,chAddConn)
else
task.spawn(function()
local folder=TCS:WaitForChild("TextChannels",5)
if folder then
for _,ch in ipairs(folder:GetChildren())do
hookTextChannel(ch)
end
local chAddConn=folder.ChildAdded:Connect(hookTextChannel)
table.insert(_G.BTR_FakeAdminConns,chAddConn)
end
end)
end
