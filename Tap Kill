watchFolder(Workspace)
else
antiFlingActiveCount=math.max(0,antiFlingActiveCount - 1)
stopCentralAntiFlingGuard()
for _,c in ipairs(carChildConns)do c:Disconnect()end
carChildConns={}
removeCarProtection()
end
end
