Title="[VIDEO] ".. v.Title,
Url="youtube://watch?v=".. v.VideoId,
DisplayUrl="m.youtube.com > ".. v.Author,
Snippet=string.format("YouTube Video (%s) - %s",v.DurationFormatted,Network.FormatViews(v.Views))
})
end
local wikiUrl=string.format(
"https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=%s&utf8=1&format=json&srlimit=4",
encoded
)
local wikiData=Network.GetJson(wikiUrl)
if wikiData and wikiData.query and type(wikiData.query.search)=="table"then
for _,item in ipairs(wikiData.query.search)do
local title=tostring(item.title or"")
if title ~=""then
local slug=string.gsub(title," ","_")
table.insert(results,{
Title=title .." - Wikipedia",
Url="https://en.m.wikipedia.org/wiki/".. HttpService:UrlEncode(slug),
DisplayUrl="en.m.wikipedia.org > ".. title,
Snippet=DomEngine.StripTags(item.snippet or"")
})
end
end
end
local ddgHtml=Network.Request("https://html.duckduckgo.com/html/?q=".. encoded)
if ddgHtml then
for href,rawTitle in string.gmatch(ddgHtml,'<a[^>]-class="result__a"[^>]-href="([^"]+)"[^>]*>(.-)</a>')do
local actual=string.match(href,"uddg=([^&]+)")
if actual then
actual=string.gsub(actual,"%%(%x%x)",function(h)
return string.char(tonumber(h,16))
end)
else
actual=href
end
local cleanTitle=DomEngine.StripTags(rawTitle)
if string.find(actual,"^https?://")and cleanTitle ~=""then
table.insert(results,{
Title=cleanTitle,
Url=actual,
DisplayUrl=Network.ExtractDomain(actual),
Snippet="Live web page on ".. Network.ExtractDomain(actual)
})
if #results >=10 then break end
end
end
end
return results
end
function DomEngine.ParseWebPage(rawHtml,baseUrl)
local html=tostring(rawHtml or"")
local pageTitle=string.match(html,"<[tT][iI][tT][lL][eE][^>]*>(.-)</[tT][iI][tT][lL][eE]>")
pageTitle=pageTitle and DomEngine.StripTags(pageTitle)or Network.ExtractDomain(baseUrl)
html=string.gsub(html,"<!%-%-.-%-%->","")
html=string.gsub(html,"<[sS][cC][rR][iI][pP][tT][^>]*>.-</[sS][cC][rR][iI][pP][tT]>"," ")
html=string.gsub(html,"<[sS][tT][yY][lL][eE][^>]*>.-</[sS][tT][yY][lL][eE]>"," ")
html=string.gsub(html,"<[sS][vV][gG][^>]*>.-</[sS][vV][gG]>"," ")
html=string.gsub(html,"<[hH][eE][aA][dD][^>]*>.-</[hH][eE][aA][dD]>"," ")
html=string.gsub(html,"<[nN][aA][vV][^>]*>.-</[nN][aA][vV]>"," ")
html=string.gsub(html,"<[fF][oO][oO][tT][eE][rR][^>]*>.-</[fF][oO][oO][tT][eE][rR]>"," ")
html=string.gsub(html,"<[fF][oO][rR][mM][^>]*>.-</[fF][oO][rR][mM]>"," ")
html=string.gsub(html,"<[bB][uU][tT][tT][oO][nN][^>]*>.-</[bB][uU][tT][tT][oO][nN]>"," ")
html=string.gsub(html,"<[sS][eE][lL][eE][cC][tT][^>]*>.-</[sS][eE][lL][eE][cC][tT]>"," ")
html=string.gsub(html,"<[iI][nN][pP][uU][tT][^>]*>"," ")
local nodes={}
local seen={}
local imgCount=0
html=string.gsub(html,'<[iI][mM][gG]%s+([^>]-)>',function(attr)
local src=string.match(attr,'[sS][rR][cC]%s*=%s*"([^"]+)"')
or string.match(attr,"[sS][rR][cC]%s*=%s*'([^']+)'")
if src and not string.find(src,"^data:")then
return"\n{{IMG|".. src .."}}\n"
end
return""
end)
html=string.gsub(html,'<[aA]%s+([^>]-)>(.-)</[aA]>',function(attr,inner)
local href=string.match(attr,'[hH][rR][eE][fF]%s*=%s*"([^"]+)"')
local text=DomEngine.StripTags(inner)
if href and #text >=2 then
return string.format("\n{{LINK|%s|%s}}\n",href,text)
end
return text
end)
for _,tag in ipairs({"h1","h2","h3","p","li"})do
html=string.gsub(html,"<".. tag .."[^>]*>(.-)</".. tag ..">",function(inner)
return string.format("\n{{BLK|%s|%s}}\n",string.upper(tag),inner)
end)
end
html=string.gsub(html,"<[^>]+>"," ")
for line in string.gmatch(html,"[^\r\n]+")do
if #nodes >=100 then break end
local imgSrc=string.match(line,"{{IMG|([^}]+)}}")
local lHref,lText=string.match(line,"{{LINK|([^|]+)|([^}]+)}}")
local bType,bText=string.match(line,"{{BLK|([^|]+)|([^}]+)}}")
if imgSrc and imgCount < 6 then
local fullImg=Network.ResolveUrl(baseUrl,imgSrc)
if fullImg and not string.find(string.lower(fullImg),"%.svg")then
imgCount=imgCount + 1
table.insert(nodes,{Type="IMG",Src=fullImg})
end
elseif lHref and lText then
local fullHref=Network.ResolveUrl(baseUrl,lHref)
local cleanL=DomEngine.StripTags(lText)
if fullHref and #cleanL >=2 and not seen["L:".. cleanL]then
seen["L:".. cleanL]=true
table.insert(nodes,{Type="A",Href=fullHref,Text=cleanL})
end
elseif bType and bText then
local cleanB=DomEngine.StripTags(string.gsub(bText,"{{LINK|[^|]+|([^}]+)}}","%1"))
if #cleanB >=3 and not seen[cleanB]then
seen[cleanB]=true
table.insert(nodes,{Type=bType,Text=cleanB})
end
end
end
return nodes,pageTitle
end
