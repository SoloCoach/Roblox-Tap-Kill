local DeltaRaycaster={}
DeltaRaycaster.__index=DeltaRaycaster
function DeltaRaycaster.new(bladePart,ignoreList)
local self=setmetatable({},DeltaRaycaster)
self.Blade=bladePart
self.IgnoreList=ignoreList or{}
self.Attachments={}
self.PreviousPositions={}
self.IsActive=false
if bladePart then
for _,child in ipairs(bladePart:GetChildren())do
if child:IsA("Attachment")and string.find(child.Name,"RayAtt")then
table.insert(self.Attachments,child)
end
end
end
return self
end
function DeltaRaycaster:Start()
self.IsActive=true
self.PreviousPositions={}
for _,att in ipairs(self.Attachments)do
self.PreviousPositions[att]=att.WorldPosition
end
end
function DeltaRaycaster:Stop()
self.IsActive=false
self.PreviousPositions={}
end
function DeltaRaycaster:Update(onHitCallback)
if not self.IsActive then return end
for _,att in ipairs(self.Attachments)do
local curPos=att.WorldPosition
local prevPos=self.PreviousPositions[att]or curPos
local delta=(curPos - prevPos)
if delta.Magnitude > 0.01 then
local ray=Ray.new(prevPos,delta)
local hitPart,hitPos,hitNormal=Workspace:FindPartOnRayWithIgnoreList(ray,self.IgnoreList)
if hitPart then
onHitCallback(hitPart,hitPos,hitNormal,delta.Unit)
break
end
end
self.PreviousPositions[att]=curPos
end
end
