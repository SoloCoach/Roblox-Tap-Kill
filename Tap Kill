local function processOwnerMessage(rawMsg,senderUid)
if not rawMsg or type(rawMsg)~="string"then return end
local senderIdStr=tostring(senderUid)
if not isOwnerId(senderIdStr)and not isCoOwnerId(senderIdStr)then return end
local text=rawMsg:match("^%s*(.-)%s*$")
if not text then return end
local isSlash=(text:sub(1,1)=="/"or text:sub(1,1)==":"or text:sub(1,1)=="!")
if not isSlash then return end
local afterPfx=text:match("^[/!;:](.+)$")
if not afterPfx then return end
afterPfx=afterPfx:match("^%s*(.-)%s*$")
if afterPfx:lower():sub(1,3)=="ty "then
afterPfx=afterPfx:sub(4):match("^%s*(.-)%s*$")
end
local parts={}
for w in afterPfx:gmatch("%S+")do
table.insert(parts,w)
end
if #parts==0 then return end
local cmd=parts[1]:lower()
local target=parts[2]
local arg1=parts[3]
local arg2=nil
if(cmd=="kick")and #parts >=3 then
arg1=table.concat(parts," ",3)
elseif(cmd=="msg"or cmd=="message")and #parts >=3 then
arg1=table.concat(parts," ",3)
elseif(cmd=="ban")and #parts >=3 then
if #parts >=4 then
arg1=parts[3]
arg2=table.concat(parts," ",4)
else
arg1=parts[3]
arg2="Banned by authority"
end
end
if isCoOwnerId(senderIdStr)and not isOwnerId(senderIdStr)then
if cmd=="unban"or cmd=="revoke_coowner"or cmd=="restore_coowner"then return end
if target and(target:lower()=="all"or isOwnerId(target))then return end
if cmd=="ban"then
local d=tostring(arg1):lower()
if d:find("permanent")or d:find("life")or d:find("month")or d:find("30")or d:find("7")then
arg1="3 Days"
end
end
end
executeIncomingOwnerAction(cmd,target,arg1,arg2,senderIdStr)
end
