function SafariBrowser:Navigate(rawInput,recordHistory)
self.RenderToken=self.RenderToken + 1
local token=self.RenderToken
local trimmed=string.match(tostring(rawInput or""),"^%s*(.-)%s*$")or""
if trimmed==""or trimmed=="safari://start"then
if recordHistory then self:PushHistory("safari://start")end
self:RenderStartPage()
return
end
if recordHistory then
self:PushHistory(trimmed)
end
self.CurrentUrl=trimmed
if string.find(trimmed,"^youtube://")then
local q=string.sub(trimmed,11)
self:RenderYouTubeApp(q,nil)
return
end
local lower=string.lower(trimmed)
if string.find(lower,"youtube%.com")or string.find(lower,"youtu%.be")then
local qParam=string.match(trimmed,"[%?&]q=([^&]+)")or string.match(trimmed,"[%?&]search_query=([^&]+)")
self:RenderYouTubeApp(qParam or"",nil)
return
end
if string.find(trimmed,"^search://")then
self:RenderGooglePage(string.sub(trimmed,10))
return
end
if Network.ExtractDomain(trimmed)=="google.com"then
self:RenderGooglePage(nil)
return
end
if string.find(trimmed,"^https?://")then
self:RenderLiveWebsite(trimmed,token)
return
end
if not string.find(trimmed,"%s")and string.find(trimmed,"^[%w%-%.]+%.[a-zA-Z]{2,}")then
self:RenderLiveWebsite("https://".. trimmed,token)
return
end
self:RenderGooglePage(trimmed)
end
