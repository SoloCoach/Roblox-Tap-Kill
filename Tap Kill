or n:find("store")or n:find("hotel")or n:find("hospital")or n:find("school")or n:find("furniture")then
return false
end
if n:find("heli")or n:find("copter")or n:find("chinook")or n:find("jet")or n:find("plane")
or n:find("canoe")or n:find("boat")or n:find("kayak")then
return false
end
if model.Parent and model.Parent.Name==_K[102]then
return true
end
local vSeat=model:FindFirstChildWhichIsA(_K[88],true)
