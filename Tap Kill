local function initEmptyBoard()
board={}
for r=1,ROWS do
board[r]={}
for c=1,COLS do
board[r][c]=nil
end
end
end
local function canPlace(pieceType,rotIdx,px,py)
local def=TETRO_DEFS[pieceType]
if not def then return false end
local mat=def.rot[rotIdx]
local sz=#mat
for r=1,sz do
for c=1,sz do
if mat[r][c]==1 then
local bx=px + c - 1
local by=py + r - 1
if bx < 1 or bx > COLS or by > ROWS then
return false
end
if by >=1 and board[by][bx]~=nil then
return false
end
end
end
end
return true
end
local function renderPreview()
local def=TETRO_DEFS[nextPieceType]
for pr=1,4 do
for pc=1,4 do
local pcell=previewCells[pr][pc]
pcell.BackgroundTransparency=1
end
end
if def then
local mat=def.rot[1]
local sz=#mat
local offsetR=math.floor((4 - sz)/ 2)
local offsetC=math.floor((4 - sz)/ 2)
for r=1,sz do
for c=1,sz do
if mat[r][c]==1 then
local tr=r + offsetR
local tc=c + offsetC
if previewCells[tr]and previewCells[tr][tc]then
previewCells[tr][tc].BackgroundColor3=def.color
previewCells[tr][tc].BackgroundTransparency=0
end
end
end
end
end
end
local function render()
for r=1,ROWS do
for c=1,COLS do
local color=board[r][c]
local cell=cells[r][c]
if color then
cell.BackgroundColor3=color
cell.BackgroundTransparency=0
else
cell.BackgroundColor3=Color3.fromRGB(22,26,38)
cell.BackgroundTransparency=0.85
end
end
end
if curPiece and not isGameOver then
local def=TETRO_DEFS[curPiece.type]
local mat=def.rot[curPiece.rot]
local sz=#mat
for r=1,sz do
for c=1,sz do
if mat[r][c]==1 then
local bx=curPiece.x + c - 1
local by=curPiece.y + r - 1
if bx >=1 and bx <=COLS and by >=1 and by <=ROWS then
cells[by][bx].BackgroundColor3=def.color
cells[by][bx].BackgroundTransparency=0
end
end
end
end
end
scoreValLbl.Text=tostring(score)
statsValLbl.Text=tostring(level).." / ".. tostring(lines)
end
local function spawnPiece()
if not nextPieceType then
nextPieceType=TETRO_TYPES[math.random(1,#TETRO_TYPES)]
end
local pType=nextPieceType
nextPieceType=TETRO_TYPES[math.random(1,#TETRO_TYPES)]
renderPreview()
local startX=4
if pType=="O"then startX=5 end
local newPiece={
type=pType,
rot=1,
x=startX,
y=1
}
