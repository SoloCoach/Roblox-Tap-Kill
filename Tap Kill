if TyShCache.friends.data and now < TyShCache.friends.expires then
if callback then
callback(true,TyShCache.friends.data.friends,TyShCache.friends.data.pendingIncoming,{cached=true})
end
return
end
local cleanMe=normalizeHandle(user)
