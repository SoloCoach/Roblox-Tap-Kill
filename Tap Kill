and math.abs(relRoot.Z)<=AntiBangState.headsitMaxHorizontal then
return"headsit"
end
if relRoot.Z < 0 then
if facingDot < -0.3 then
if relRoot.Y < -0.8 then
return"kneel"
end
return"facebang"
end
return"front attach"
end
if facingDot > 0.3 then
return"bang"
end
