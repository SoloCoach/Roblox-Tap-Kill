local function attachCarProtection(model)
local char=lp.Character
if not char or not model then return end
local keyParts=getCharacterProtectParts(char)
if #keyParts==0 then return end
for _,part in ipairs(model:GetDescendants())do
if part:IsA("BasePart")and part.CanCollide then
local sz=part.Size
if sz.X <=40 and sz.Z <=40 and sz.Y <=25 then
for _,kp in ipairs(keyParts)do
local tag="TySh_CarNCC_".. kp.Name
if not part:FindFirstChild(tag)then
local ncc=Instance.new("NoCollisionConstraint")
ncc.Name=tag
ncc.Part0=part
ncc.Part1=kp
ncc.Parent=part
table.insert(carActiveNccs,ncc)
end
end
end
end
end
end
applyAllCars=function()
for _,c in ipairs(getGroundCars())do
attachCarProtection(c)
end
end
local function removeCarProtection()
for _,ncc in ipairs(carActiveNccs)do
if ncc and ncc.Parent then
pcall(function()ncc:Destroy()end)
end
end
carActiveNccs={}
end
