local function checkUsernameCooldown()
local TWO_WEEKS=14 * 24 * 3600
local last=phoneConfig.lastUsernameChange or 0
if last > 1000000000000 then last=math.floor(last / 1000)end
local now=os.time()
local elapsed=now - last
if last > 0 and elapsed < TWO_WEEKS then
local left=TWO_WEEKS - elapsed
local days=math.ceil(left / 86400)
hCooldownInfo.TextColor3=Color3.fromRGB(255,149,0)
hCooldownInfo.Text="Cooldown Active: Next username change allowed in ".. tostring(days).." day(s)."
hSaveBtn.BackgroundColor3=Color3.fromRGB(60,65,80)
hSaveBtn.Text="COOLDOWN ACTIVE (".. tostring(days).."D)"
return false
else
hCooldownInfo.TextColor3=Color3.fromRGB(48,209,88)
hCooldownInfo.Text="Username change is available now. (1 change every 14 days)"
hSaveBtn.BackgroundColor3=phoneConfig.themeColor
hSaveBtn.Text="SAVE USERNAME"
return true
end
end
