elseif tag.Billboard.Adornee ~=currentHead then
tag.Billboard.Adornee=currentHead
tag.Head=currentHead
end
local distance=(currentHead.Position - originPos).Magnitude
if distance >=MAX_VISIBLE_DISTANCE then
if tag.Billboard.Enabled then
tag.Billboard.Enabled=false
end
continue
end
if not tag.Billboard.Enabled then
tag.Billboard.Enabled=true
end
local proximity=1
if distance > FADE_START_DISTANCE then
local raw=1 -((distance - FADE_START_DISTANCE)/(MAX_VISIBLE_DISTANCE - FADE_START_DISTANCE))
proximity=raw * raw *(3 - 2 * raw)
end
tag.Canvas.GroupTransparency=1 - proximity
local baseScale=0.72 +(0.32 * proximity)
tag.Scale.Scale=baseScale * MOBILE_SCALE_BOOST
local t=now + tag.TimeOffset
local floatY=math.sin(t * 2.2)* 0.08
local headHeight=(currentHead:IsA("BasePart")and currentHead.Size.Y)or 1.2
local calculatedY=1.6 +(headHeight * 0.85)+ floatY
tag.Billboard.StudsOffsetWorldSpace=Vector3.new(0,calculatedY,0)
tag.Billboard.StudsOffset=Vector3.zero
tag.StrokeGradient.Rotation=(t * 65)% 360
local sheenCycle=(t * 0.65)% 2.5
tag.SheenGradient.Offset=Vector2.new(math.clamp(sheenCycle - 1,-1,1),0)
local wingWidth=math.floor(58 * proximity)
tag.LeftWing.Size=UDim2.fromOffset(wingWidth,1)
tag.RightWing.Size=UDim2.fromOffset(wingWidth,1)
tag.CenterDiamond.Rotation=(t * 90)% 360
for _,p in ipairs(tag.Particles)do
local life=(t * p.Speed + p.Phase)% 1
local driftX=math.sin(t * 2.5 + p.Phase)* 0.025
local posY=0.78 -(life * 0.58)
local sparkAlpha=math.sin(life * math.pi)
local currentSize=p.MaxSize * sparkAlpha
p.Frame.Position=UDim2.fromScale(p.BaseX + driftX,posY)
p.Frame.Size=UDim2.fromOffset(currentSize,currentSize)
p.Frame.BackgroundTransparency=1 -(sparkAlpha * 0.85)
end
end
end)
