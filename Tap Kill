if uis:IsKeyDown(Enum.KeyCode.S)or uis:IsKeyDown(Enum.KeyCode.Down)then moveThrottle=moveThrottle - 1.0 end
if uis:IsKeyDown(Enum.KeyCode.A)or uis:IsKeyDown(Enum.KeyCode.Left)then steerYaw=steerYaw - 1.0 end
