local function computeLongBoneCFrame(startPos: Vector3,endPos: Vector3,upVector: Vector3,rollRad: number): CFrame
local midPoint=(startPos + endPos)* 0.5
local dir=endPos - startPos
if dir.Magnitude < 0.001 then
return CF(midPoint)
end
return CFrame.lookAt(midPoint,endPos,upVector)* AXIAL_X_ALIGNMENT * CFAngles(rollRad,0,0)
end
local function solveTwoBoneIK(
originPos: Vector3,
targetPos: Vector3,
poleVector: Vector3,
lenA: number,
lenB: number
): Vector3
local toTarget=targetPos - originPos
local dist=toTarget.Magnitude
local maxReach=(lenA + lenB)- 0.05
local minReach=math.abs(lenA - lenB)+ 0.05
local clampedDist=math.clamp(dist,minReach,maxReach)
local forwardDir=if dist > 0.001 then toTarget.Unit else V3(0,-1,0)
local cosAngle=math.clamp(
(lenA * lenA + clampedDist * clampedDist - lenB * lenB)/(2 * lenA * clampedDist),
-1,
1
)
local angle=math.acos(cosAngle)
local bendAxis=(poleVector - forwardDir * poleVector:Dot(forwardDir))
if bendAxis.Magnitude < 0.001 then
bendAxis=V3(0,0,1)
else
bendAxis=bendAxis.Unit
end
local jointOffset=(forwardDir * math.cos(angle)+ bendAxis * math.sin(angle))* lenA
return originPos + jointOffset
end
