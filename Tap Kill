function AudioStreamResolver:DownloadAndAssembleHlsMp3(m3u8Url,onProgress)
local playlist=Network.Request(m3u8Url)
if not playlist then return nil end
local segments={}
for line in string.gmatch(playlist,"[^\r\n]+")do
local trimmed=string.match(line,"^%s*(.-)%s*$")or""
if trimmed ~=""and string.sub(trimmed,1,1)~="#"and string.find(trimmed,"^https?://")then
table.insert(segments,trimmed)
end
end
if #segments==0 then return nil end
local chunks={}
local batchSize=10
for startIdx=1,#segments,batchSize do
local endIdx=math.min(#segments,startIdx + batchSize - 1)
local pending=(endIdx - startIdx + 1)
for idx=startIdx,endIdx do
task.spawn(function()
chunks[idx]=Network.Request(segments[idx])or""
pending=pending - 1
end)
end
local t0=os.clock()
while pending > 0 and(os.clock()- t0)< 12.0 do
task.wait(0.03)
end
if onProgress then
pcall(onProgress,math.floor((endIdx / #segments)* 100))
end
end
local ordered={}
for i=1,#segments do
if chunks[i]and #chunks[i]> 0 then
table.insert(ordered,chunks[i])
end
end
return table.concat(ordered,"")
end
function AudioStreamResolver:FetchFullAudioForTitle(searchTitle,targetDurationSec,onProgress)
local cid=self:GetSoundCloudClientId()
if not cid then return nil end
local cleanQuery=string.gsub(tostring(searchTitle or""),"%b()"," ")
cleanQuery=string.gsub(cleanQuery,"%b[]"," ")
local encoded=HttpService:UrlEncode(cleanQuery)
local url=string.format("https://api-v2.soundcloud.com/search/tracks?q=%s&client_id=%s&limit=20",encoded,cid)
local data=Network.GetJson(url)
if not data or type(data.collection)~="table"then
return nil
end
local bestTranscodingUrl=nil
local bestProto=nil
local bestDiff=999999
for _,item in ipairs(data.collection)do
local durSec=math.floor((tonumber(item.duration)or 0)/ 1000)
local fullDurSec=math.floor((tonumber(item.full_duration)or(durSec * 1000))/ 1000)
if item.policy ~="SNIP"and durSec >=35 and math.abs(fullDurSec - durSec)<=3 then
if item.media and type(item.media.transcodings)=="table"then
for _,tr in ipairs(item.media.transcodings)do
local fmt=tr.format
local proto=tostring(fmt and fmt.protocol or"")
local mime=tostring(fmt and fmt.mime_type or"")
if fmt and not string.find(proto,"encrypted",1,true)and tr.snipped ~=true then
if(proto=="progressive"or proto=="hls")and mime=="audio/mpeg"then
local diff=(targetDurationSec and targetDurationSec > 0)
and math.abs(durSec - targetDurationSec)
or 0
if diff < bestDiff then
bestDiff=diff
bestTranscodingUrl=tr.url
bestProto=proto
end
end
end
end
end
end
end
if not bestTranscodingUrl then return nil end
local sep=string.find(bestTranscodingUrl,"?",1,true)and"&"or"?"
local streamInfo=Network.GetJson(string.format("%s%sclient_id=%s",bestTranscodingUrl,sep,cid))
if not streamInfo or not streamInfo.url then return nil end
local audioBytes=nil
if bestProto=="progressive"then
audioBytes=Network.Request(streamInfo.url)
else
audioBytes=self:DownloadAndAssembleHlsMp3(streamInfo.url,onProgress)
end
if not audioBytes or #audioBytes < 150000 or not WriteFile or not GetCustomAsset then
return nil
end
local mp3Path=string.format("%s/vid_audio_%s.mp3",CONFIG.CacheDirectory,Network.HashString(searchTitle))
local okWrite=pcall(WriteFile,mp3Path,audioBytes)
if not okWrite then return nil end
