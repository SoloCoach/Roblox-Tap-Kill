local function solveDigitigradeLegIK(
hipPos: Vector3,
footPos: Vector3,
side: number,
pelvisCF: CFrame,
liftAlpha: number
):(CFrame,Vector3,CFrame,Vector3,CFrame)
local forward=pelvisCF.LookVector
local up=pelvisCF.UpVector
local right=pelvisCF.RightVector
local crouchFlex=stalkWeight * math.rad(14)+ pounceChargeWeight * math.rad(18)
local hockTilt=math.rad(38)+ crouchFlex - liftAlpha * math.rad(22)
local metaDir=(-forward * math.sin(hockTilt)+ up * math.cos(hockTilt)+ right *(side * 0.08)).Unit
local anklePos=footPos + metaDir * METATARSUS_LEN
local hipToAnkle=anklePos - hipPos
local distHA=hipToAnkle.Magnitude
local maxHA=(FEMUR_LEN + TIBIA_LEN)- 0.08
local minHA=math.abs(FEMUR_LEN - TIBIA_LEN)+ 0.15
if distHA > maxHA then
anklePos=hipPos + hipToAnkle.Unit * maxHA
distHA=maxHA
hipToAnkle=anklePos - hipPos
elseif distHA < minHA then
anklePos=hipPos + hipToAnkle.Unit * minHA
distHA=minHA
hipToAnkle=anklePos - hipPos
end
local dirHA=if distHA > 0.001 then hipToAnkle.Unit else -up
local cosA=math.clamp(
(FEMUR_LEN * FEMUR_LEN + distHA * distHA - TIBIA_LEN * TIBIA_LEN)/(2 * FEMUR_LEN * distHA),
-1,1
)
local angleA=math.acos(cosA)
local kneeOutward=0.25 + stalkWeight * 0.25 + pounceChargeWeight * 0.25
local kneePole=(forward * 1.55 + up * 0.35 + right *(side * kneeOutward)).Unit
local bendAxis=dirHA:Cross(kneePole)
if bendAxis.Magnitude < 0.001 then bendAxis=right else bendAxis=bendAxis.Unit end
local femurDir=(CFrame.fromAxisAngle(bendAxis,-angleA)* dirHA).Unit
local kneePos=hipPos + femurDir * FEMUR_LEN
local femurMid=hipPos:Lerp(kneePos,0.5)
local tibiaMid=kneePos:Lerp(anklePos,0.5)
local metaMid=anklePos:Lerp(footPos,0.5)
local femurCF=CFrame.lookAt(femurMid,kneePos,kneePole)* CFrame.Angles(0,math.rad(90),0)
local tibiaCF=CFrame.lookAt(tibiaMid,anklePos,forward)* CFrame.Angles(0,math.rad(90),0)
local metaCF=CFrame.lookAt(metaMid,footPos,forward)* CFrame.Angles(0,math.rad(90),0)
return femurCF,kneePos,tibiaCF,anklePos,metaCF
end
